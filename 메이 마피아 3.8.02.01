			1);
		Skip If(Array Contains(Mapped Array(Filtered Array(Event Player.Condition, Array Contains(Current Array Element, Custom String(
			"희생"))), Last Of(Current Array Element)).Condition, Custom String("치유")), 2);
		Modify Global Variable(Execute_players, Append To Array, Mapped Array(Filtered Array(Event Player.Condition, Array Contains(
			Current Array Element, Custom String("희생"))), Last Of(Current Array Element)));
		Event Player.P_Message_request[Count Of(Event Player.P_Message_request)] = Array(3, Mapped Array(Filtered Array(
			Event Player.Condition, Array Contains(Current Array Element, Custom String("희생"))), Last Of(Current Array Element)),
			Hero Icon String(Hero(겐지)), Custom String("[{0}]님을 위해 희생하였습니다", Event Player.Name_plate));
	}
}

