		Event Player.Power == Custom String("불면증");
	}

	action
	{
		If(Filtered Array(Global.Players, Array Contains(Current Array Element.Condition, Custom String("살해"))));
			Event Player.Sound_effect = 4;
		End;
		Wait(1, Ignore Condition);
		If(Filtered Array(Global.Players, Array Contains(Current Array Element.Condition, Custom String("살인"))));
			Event Player.Sound_effect = 4;
		End;
	}
}

