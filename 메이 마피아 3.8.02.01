		Event Player.Power_able_left = 0;
		Event Player.Power_able_targets = 0;
		Event Player.Power_type = 0;
		Event Player.Class = 1;
		Event Player.Role_icon = Hero(메이);
		Event Player.Role_guide = Custom String("[불면증]\r\n밤에 들려오는 총소리를 듣는\r\n유일한 직업입니다");
		Event Player.Tips_and_jokes = Array(Custom String("Tip: 밤에는 귀를 기울이세요! 총소리가 들린답니다"), Custom String("Tip: 때론 용감하게, 백수가 아닌 척"));
		Event Player.Tip_or_joke = Random Value In Array(Event Player.Tips_and_jokes);
		Abort If(Global.Time_muchine);
		Event Player.Team = 1;
		Event Player.Team_color = 1;
		Skip If(Array Contains(Global.Citizen_team, Event Player), 1);
		Modify Global Variable(Citizen_team, Append To Array, Event Player);
	}
}

rule("총소리 듣기")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
