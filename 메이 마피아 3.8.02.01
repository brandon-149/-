rule("[서브 루틴] 3 세력 선정")
{
	event
	{
		Subroutine;
		TF_picking;
	}

	action
	{
		Wait(0.250, Ignore Condition);
		Global.Pick_role = Null;
		Global.Random_value = Random Real(0, 100);
		If(Global.Random_value <= 35.714);
			Global.Pick_role = Custom String("살인마");
		Else If(Global.Random_value <= 71.429);
			Global.Pick_role = Custom String("스토커");
