}

rule("도굴꾼 - 직업 받기")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Day == 1;
		Global.Time == 5;
		Event Player.Role == Custom String("도굴꾼");
		Event Player.Dead == False;
	}

	action
	{
		If(Count Of(Global.Dead_players) == 1);
			Event Player.Role = First Of(Global.Dead_players).Role;
			If(First Of(Global.Dead_players).Team == 4);
				First Of(Global.Dead_players).Role = Custom String("악인");
			Else;
				First Of(Global.Dead_players).Role = Custom String("시민");
			End;
			Global.Message_request[Count Of(Global.Message_request)] = Array(3, Event Player, Hero Icon String(Event Player.Role_icon),
				Custom String("새로운 직업을 얻었습니다"));
		Else;
			If(Random Integer(1, 100) <= Global.Mode_setting[5]);
				Event Player.Role = Custom String("타임머신을 발굴한 도굴꾼");
				Global.Message_request[Count Of(Global.Message_request)] = Array(3, Event Player, Hero Icon String(Event Player.Role_icon),
					Custom String("[타임머신]을 발견했습니다"));
			Else;
				Global.Message_request[Count Of(Global.Message_request)] = Array(3, Event Player, Hero Icon String(Event Player.Role_icon),
					Custom String("도구리는 [도굴 도굴]하고 운데요"));
			End;
		End;
	}
}

rule("기자 설정")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.Role == Custom String("기자");
	}

	action
	{
		Event Player.Power = Custom String("특종");
		Event Player.Power_able_day = 3;
		Event Player.Power_able_left = 1;
		Event Player.Power_able_targets = 1;
		Event Player.Power_type = 2;
		Event Player.Class = 3;
		Event Player.Role_icon = Hero(루시우);
		Event Player.Role_guide = Custom String(
			"[특종]\r\n3번째 밤이 되면 능력을 얻습니다\r\n단 한 번, 대상의 직업을 모두에게 알립니다\r\n\r\n낮이 오기 전 사망할 경우 기사가 뜨지 않으며\r\n대상이 사망할 경우 특종은 사망만을 알립니다");
		Event Player.Tips_and_jokes = Array(Custom String("Tip: 맞 직업의 특종 기사를 노려보세요!"), Custom String("기자로써 진실을 전하고 싶어요!"));
		Event Player.Tip_or_joke = Random Value In Array(Event Player.Tips_and_jokes);
		Abort If(Global.Time_muchine);
		Event Player.Team = 1;
		Event Player.Team_color = 1;
		Skip If(Array Contains(Global.Citizen_team, Event Player), 1);
		Modify Global Variable(Citizen_team, Append To Array, Event Player);
	}
}

rule("기자 - 특종")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Time == 5;
		Event Player.Target == True;
		Event Player.Power == Custom String("특종");
	}

	action
	{
		If(Event Player.Dead);
			Global.Message_request[Count Of(Global.Message_request)] = Array(3, Event Player, Hero Icon String(Event Player.Role_icon),
				Custom String("기사를 내기 전날 당신은 죽었습니다"));
		Else If(Event Player.Target.Dead);
			Global.Message_request[Count Of(Global.Message_request)] = Array(1, Global.Players, Hero Icon String(Event Player.Role_icon),
				Custom String("[{0}], 싸늘한 시체로 발견되어 충격..!", Event Player.Target.Name_plate));
		Else If(Event Player.Ability_target.Role == Custom String("기계 인간"));
		Else If(Event Player.Ability_target.Power == Custom String("특종"));
			Global.Message_request[Count Of(Global.Message_request)] = Array(1, Global.Players, Hero Icon String(Event Player.Role_icon),
				Custom String("멍청한 기자, [{0}]!", Event Player.Target.Name_plate));
		Else;
			Global.Message_request[Count Of(Global.Message_request)] = Array(1, Global.Players, Hero Icon String(Event Player.Role_icon),
				Custom String("특종이오! [{0}]님은 [{1}]입니다!", Event Player.Target.Name_plate, Event Player.Ability_target.Role));
		End;
	}
}

