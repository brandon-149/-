		Event Player.Power_type = 1;
		Event Player.Class = 2;
		Event Player.Role_icon = Hero(솔저: 76);
		Event Player.Role_guide = Custom String("[수사]\r\n{0}번째 날부터,\r\n밤마다 한 명을 지목하여\r\n마피아 여부를 확인합니다", Event Player.Power_able_day);
		Event Player.Tips_and_jokes = Array(Custom String("Tip: 어쩔 땐 조사 결과보다 당신의 촉이 맞습니다"), Custom String("Tip: 의사와 친해지세요"), Custom String(
			"Tip: 도둑 잡는 경찰이죠!"));
		Event Player.Tip_or_joke = Random Value In Array(Event Player.Tips_and_jokes);
		Abort If(Global.Time_muchine);
		Event Player.Team = 1;
		Event Player.Team_color = 1;
		Skip If(Array Contains(Global.Citizen_team, Event Player), 1);
