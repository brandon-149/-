				Custom String("[{0}]님에게 기운이 느껴지지 않습니다", Event Player.Target.Name_plate));
		Else;
			Global.Message_request[Count Of(Global.Message_request)] = Array(3, Event Player, Hero Icon String(Event Player.Role_icon),
				Custom String("[{0}]님은 [악한 기운]이 느껴집니다", Event Player.Target.Name_plate));
		End;
	}
}

