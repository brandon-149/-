rule("[서브 루틴] 전체 UI")
{
	event
	{
		Subroutine;
		G_UI;
	}

	action
	{
		"LEFT"
		Create HUD Text(All Players(All Teams), Null, Null, Global.Mode_setting[0] ? Custom String("{0} / {1} / {2}\r\n", Server Load,
			Server Load Average, Server Load Peak) : Custom String("우비의 워크샵\r\n"), Left, 0, Color(흰색), Color(흰색), Color(흰색),
			Visible To and String, Default Visibility);
		Create HUD Text(All Players(All Teams), Hero Icon String(Hero(메이)), Custom String("시민 팀"), Custom String(
			"시민 {0}명　중직 {1}명　특수 직업 {2}명", Global.Role_count[0], Global.Role_count[1], Global.Role_count[2]), Left, 1, Color(Sky Blue),
			Color(Sky Blue), Color(흰색), Visible To and String, Default Visibility);
		Create HUD Text(All Players(All Teams), Hero Icon String(Hero(리퍼)), Custom String("마피아 팀"), Custom String(
			"마피아 {0}명　특수 직업 {1}명            ", Global.Role_count[3], Global.Role_count[4]), Left, 2, Color(Red), Color(Red), Color(흰색),
			Visible To and String, Default Visibility);
		Create HUD Text(All Players(All Teams), Hero Icon String(Hero(로드호그)), Custom String("3 세력"), Custom String(
			"3 세력 {0}명                                   ", Global.Role_count[5]), Left, 3, Color(Purple), Color(Purple), Color(흰색),
			Visible To and String, Default Visibility);
		Create HUD Text(Filtered Array(All Players(All Teams), !Current Array Element.Guide), Null, Null, Custom String(
			"\r\n　활성화된 직업 {0} 열기\r\n", Input Binding String(Button(Reload))), Left, 4, Color(흰색), Color(흰색), Color(흰색),
			Visible To and String, Default Visibility);
		Create HUD Text(Filtered Array(All Players(All Teams), Current Array Element.Guide), Null, Null, Custom String(
			"\r\n　활성화된 직업 {1} 닫기\r\n{0}",
			Global.Able_role_setting[0] || Global.Able_role_setting[1] || Global.Able_role_setting[2] ? Custom String("{0}{1}{2}",
			Global.Able_role_setting[0] ? Custom String("\r\n－시민 팀\r\n{0}\r\n", Global.Able_role_setting[0]) : Custom String(""),
			Global.Able_role_setting[1] ? Custom String("\r\n－마피아 팀\r\n{0}\r\n", Global.Able_role_setting[1]) : Custom String(""),
			Global.Able_role_setting[2] ? Custom String("\r\n－3 세력\r\n{0}\r\n", Global.Able_role_setting[2]) : Custom String(""))
			: Custom String("\r\n－없음"), Input Binding String(Button(Reload))), Left, 4, Color(흰색), Color(흰색), Color(흰색),
			Visible To and String, Default Visibility);
		"Top"
		Create Progress Bar HUD Text(All Players(All Teams), Global.Time_for_timer ? Match Time / Global.UI_color * 100 : 0,
			Global.Time_for_timer ? Custom String("남은 시간 {0}", Round To Integer(Match Time, Up)) : Custom String(" "), Top, -7,
			Custom Color(255, Match Time / Global.UI_color * 200, 0, 255), Color(흰색), Visible To Values and Color, Default Visibility);
		Create HUD Text(All Players(All Teams), Null, Null, Custom String(" "), Top, -6, Color(흰색), Color(흰색), Color(흰색),
			Visible To and String, Default Visibility);
		Create HUD Text(Filtered Array(All Players(All Teams), Current Array Element.Ability_UI != 2), Null, Custom String(" "),
			Custom String(" "), Top, -5, Color(흰색), Color(흰색), Color(흰색), Visible To and String, Default Visibility);
		Create HUD Text(Filtered Array(Global.Players, !Current Array Element.Using_camera), Null, Custom String("\r\n"), Custom String(
			"\r\n\r\n\r\n\r\n★\r\n\r\n\r\n\r\n"), Top, -3, Color(흰색), Color(흰색), Color(Green), Visible To and String, Default Visibility);
		Create HUD Text(Filtered Array(Global.Players, Current Array Element.Using_camera), Null, Custom String("\r\n"), Custom String(
			"\r\n\r\n\r\n\r\n\n{0}\r\n\r\n\r\n\r\n\r", Custom String(" ")), Top, -3, Color(흰색), Color(흰색), Color(Green),
			Visible To and String, Default Visibility);
		"Right"
		Create HUD Text(Filtered Array(All Players(All Teams), (Count Of(Global.Mafia_team) >= 2 && Array Contains(Global.Mafia_team,
			Current Array Element)) || (Count Of(Global.TF_team) >= 2 && Array Contains(Global.TF_team, Current Array Element))), Null,
			Null, Custom String("\r\n팀\r\n"), Right, 2, Color(흰색), Color(흰색), Color(흰색), Visible To and String, Default Visibility);
		Create HUD Text(All Players(All Teams), Null, Null, Custom String("\r\n"), Right, 0, Color(흰색), Color(흰색), Color(흰색),
			Visible To and String, Default Visibility);
	}
}

rule("개인 UI")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Squence == 2;
		Event Player.Joined == True;
	}

	action
	{
		"Top"
		Create HUD Text(Event Player, Null, Null, Custom String("{0}\r\n", Global.Time == 6 && Event Player.P_Yes_or_no ? Custom String(
			"{0} 시간 증가　　　{1} 시간 단축", Input Binding String(Button(Ultimate)), Input Binding String(Button(Ability 2))) : (
			Global.Time == 6 && Event Player.Dead ? Custom String("{0} 절레 절레　　　{1} 끄덕 끄덕　　　{2}  응시", Input Binding String(Button(
			Ultimate)), Input Binding String(Button(Ability 2)), Input Binding String(Button(Primary Fire))) : (
			Global.Time == 10 && First Of(Global.Voted_players) == Event Player ? Custom String("{0} 시간 증가", Input Binding String(Button(
			Ultimate))) : (Global.Time == 11 && Event Player.P_Yes_or_no ? Custom String("{0} 반대　　　{1} 찬성", Input Binding String(Button(
			Ultimate)), Input Binding String(Button(Ability 2))) : (
			Event Player.Dead ? Event Player.Ghost_tip : Event Player.Tip_or_joke))))), Top, -8, Color(흰색), Color(흰색), Color(흰색),
			Visible To and String, Default Visibility);
		disabled Skip If(Global.Game_mode == Custom String("클래식"), 2);
		disabled Create HUD Text(Filtered Array(Event Player, Event Player.Ability), First Of(Event Player.Ability_list)
			!= False || Event Player.Pick_number ? Event Player.Ability_list[Event Player.Pick_number].Name_plate : Custom String("선택 안함"),
			Null, Null, Top, -5, Color(Red), Color(흰색), Color(흰색), Visible To and String, Default Visibility);
		disabled Create HUD Text(Filtered Array(Event Player, Event Player.Ability_for_voting),
			Event Player.Pick_number_for_voting ? Global.Voter_list[Event Player.Pick_number_for_voting].Name_plate : Custom String(
			"선택 안함"), Null, Null, Top, -5, Color(Orange), Color(흰색), Color(흰색), Visible To and String, Default Visibility);
		Create HUD Text(Event Player, Null, Null, Event Player.Ability && Event Player.Ability_UI == 2 ? Custom String(
			"< {0} > 플레이어 변경　　　{1} [{2}]사용", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Jump)),
			Event Player.Ability ? Event Player.Power : Custom String("투표")) : (Event Player.Ability_for_voting || (
			Event Player.Ability && Event Player.Ability_UI == 1) ? Custom String("{0} 본인에게 [{2}]사용　　　{1} [{2}]사용", Input Binding String(
			Button(Crouch)), Input Binding String(Button(Primary Fire)), Event Player.Ability ? Event Player.Power : Custom String("투표"))
			: Custom String(" ")), Top, -4, Color(흰색), Color(흰색), Color(흰색), Visible To and String, Default Visibility);
	}
}

rule("타이머")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Match Time == 0;
		Global.Squence == 2;
	}

	action
	{
		If(Global.Game_mode == Custom String("클래식"));
			Call Subroutine(Classic_mode_timer);
		Else;
			Call Subroutine(Nomal_and_hard_mode_timer);
		End;
		Global.Time_for_timer = Null;
	}
}

rule("[서브 루틴] 시간 - 노말,하드 모드")
{
	event
	{
		Subroutine;
		Nomal_and_hard_mode_timer;
	}

	action
	{
		If(Global.Time >= Global.Time_limit);
			Global.Time = 1;
			Abort;
		End;
		Global.Time += 1;
	}
}

rule("[서브 루틴] 시간 - 클래식 모드")
{
	event
	{
		Subroutine;
		Classic_mode_timer;
	}

	action
	{
		If(Global.Time >= Global.Time_limit);
			Global.Time = 1;
			Abort;
		Else If((Global.Time == 1 || Global.Time == 2) && Global.Night_time_for_classic < (Global.Count_of_players >= 9 ? 4 : 3));
			Global.Time = 2;
			Global.Night_time_for_classic += 1;
		Else;
			Global.Time += 1;
			If(Global.Night_time_for_classic >= (Global.Count_of_players >= 9 ? 4 : 3));
				Global.Night_time_for_classic = 0;
			End;
		End;
	}
}

rule("시간 - 하루 끝 - 변수 시작과 정리")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global.Time == 1;
	}

	action
	{
		Set Match Time(3);
		Global.Time_for_night_morning_else = 1;
		Global.UI = Custom String("밤이 깊어옵니다");
		Big Message(All Players(All Teams), Custom String("밤이 깊어옵니다"));
		Global.Day += 1;
		Global.Execute_players = Empty Array;
		Global.Voted_players = Empty Array;
		Global.G_Yes_or_no = Empty Array;
	}
}

rule("하루 끝 - 개인 변수 정리 및 수면")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Time == 1;
		Event Player.Joined == True;
	}

	action
	{
		Event Player.Camera_type = 1;
		Start Facing(Event Player, Direction From Angles(Horizontal Angle From Direction(Direction Towards(Event Player,
			Global.Map_point)), 85), 150, To World, Direction and Turn Rate);
		Event Player.Votes = Empty Array;
		Event Player.Votes_counter = Null;
	}
}

rule("시간 - 밤 - 능력 사용")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global.Time == 2;
		Global.Game_mode != Custom String("클래식");
	}

	action
	{
		Set Match Time(Min(30, Max(15, Count Of(Global.Live_players) * 4)));
		Global.Time_for_timer = 1;
		Global.UI = Custom String("밤이 되었습니다");
	}
}

rule("밤 능력권")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Time == 2;
		Global.Game_mode != Custom String("클래식");
		Event Player.Dead == False;
		Event Player.Power_able_day == True;
		Event Player.Power_able_day - Global.Day <= 0;
		Event Player.Power_able_left == True;
		Count Of(Event Player.Ability_list) >= 2;
		Event Player.Power_able_targets < 20;
	}

	action
	{
		Abort If(Event Player.Power == Custom String("자폭"));
		If(Array Contains(Event Player.Condition, Custom String("현혹")));
			Global.Message_request[Count Of(Global.Message_request)] = Array(3, Event Player, Hero Icon String(Hero(위도우메이커)), Custom String(
				"오늘은 안돼 자기야♥"));
		Else;
			Event Player.Ability = 1;
		End;
	}
}

rule("마피아 밤에 기상")
{
	event
	{
		Ongoing - Each Player;
		All;
