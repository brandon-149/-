}

rule("시간 - 밤 - 의사의 밤 - 클래식")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global.Time == 2;
		Global.Night_time_for_classic == 2;
	}

	action
	{
		Filtered Array(Global.Live_players, Current Array Element.Role == Custom String("경찰")).Value_for_ability = True;
