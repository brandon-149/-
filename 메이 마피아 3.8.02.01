		Big Message(All Players(All Teams), Custom String("투표가 시작됩니다"));
		Global.Voter_list = Append To Array(False, Global.Live_players);
	}
}

rule("오후 - 개인 변수 정리")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Time == 7;
		Event Player.Joined == True;
	}

	action
	{
		Event Player.Target = Null;
		Event Player.Ability_target = Null;
		Event Player.P_Yes_or_no = Null;
		Event Player.Pick_number_for_voting = Null;
		Event Player.Done_voting = False;
		Disallow Button(Event Player, Button(Jump));
		Disallow Button(Event Player, Button(Crouch));
	}
}

rule("시간 - 투표 시간")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
