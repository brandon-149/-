rule("Squence=1 플레이어")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Squence == 1;
		Event Player.Joined == True;
	}

	action
	{
		Event Player.Camera_type = 3;
		Call Subroutine(Player_setting);
		Call Subroutine(Player_variable_setting);
		Call Subroutine(Player_position_setting);
		Teleport(Event Player, Event Player.Player_position);
		Disable Nameplates(Event Player, All Players(All Teams));
		Start Forcing Player Outlines(All Players(All Teams), Event Player, False, Color(흰색), Default);
		disabled Create HUD Text(Event Player, Null, Null, Custom String("\r\n[{0}]", Event Player.Name_plate), Right, 0, Color(흰색), Color(흰색),
			Color(흰색), Visible To and String, Default Visibility);
		Call Subroutine(Name_plate);
	}
}

rule("[서브 루틴] 플레이어 세팅")
{
	event
	{
		Subroutine;
		Player_setting;
	}

	action
	{
		Set Primary Fire Enabled(Event Player, False);
		Set Secondary Fire Enabled(Event Player, False);
		Set Ability 1 Enabled(Event Player, False);
		Set Ability 2 Enabled(Event Player, False);
		Set Ultimate Ability Enabled(Event Player, False);
		Disallow Button(Event Player, Button(Crouch));
		Disallow Button(Event Player, Button(Jump));
		Start Forcing Throttle(Event Player, 0, 0, 0, 0, 0, 0);
		Heal(Event Player, Null, 250);
		Set Status(Event Player, Null, Invincible, 9999);
		Disable Game Mode HUD(Event Player);
		Disable Hero HUD(Event Player);
		Set Respawn Max Time(Event Player, 1);
	}
}

rule("[서브 루틴] 플레이어 변수")
{
	event
	{
		Subroutine;
		Player_variable_setting;
	}

	action
	{
		Event Player.Name_plate = Custom String("{0}. {1}", Index Of Array Value(Global.Players, Event Player) + 1, Event Player);
		Event Player.Condition = Empty Array;
		Event Player.Ability_black_list = Empty Array;
		Event Player.P_Message_request = Empty Array;
		Event Player.Votes_message_text_ID = Empty Array;
		Event Player.Ghost_tip = Random Value In Array(Global.Ghost_tips);
		Event Player.Head = 1;
		Event Player.Event_player = Array(Event Player);
	}
}

rule("[서브 루틴] 플레이어 포지션")
{
	event
	{
		Subroutine;
		Player_position_setting;
	}

	action
	{
		If(Array Contains(Global.Winner_list, Event Player));
			Event Player.Player_position = Global.Location[2] + Global.Location[3] * -0.500 * (2.500 - Count Of(Global.Winner_list) / 6.200)
				* (Count Of(Global.Winner_list) - 1) + Index Of Array Value(Global.Winner_list, Event Player) * Global.Location[3] * (
				2.500 - Count Of(Global.Winner_list) / 6.200);
		Else If(Array Contains(Global.Loser_list, Event Player));
			Event Player.Player_position = Global.Location[4] + Global.Location[5] * -0.500 * (3.200 - Count Of(Global.Loser_list) / 10) * (
				Count Of(Global.Loser_list) - 1) + Index Of Array Value(Global.Loser_list, Event Player) * Global.Location[5] * (
				3.200 - Count Of(Global.Loser_list) / 10);
		Else;
			Event Player.Player_position = Global.Map_point + 4 * Direction From Angles(360 / Global.Count_of_players * (Index Of Array Value(
				Global.Players, Event Player) + 1), 0);
		End;
	}
}

rule("Squence = 2 게임 시작")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global.Squence == 2;
	}

	action
	{
		For Global Variable(For_Division_roles, 0, 6, 1);
			Global.Role_count[Global.For_Division_roles] = Count Of(Filtered Array(Global.Players,
				Current Array Element.Class == Global.For_Division_roles + 1));
		End;
		Call Subroutine(G_UI);
		Skip If(Global.Game_mode == Custom String("클래식"), 3);
		Call Subroutine(Role_able_citizen);
		Call Subroutine(Role_able_mafia);
		Call Subroutine(Role_able_TF);
		Global.UI_small = Custom String("직업에 불평 중...");
		Wait(5, Ignore Condition);
		Set Match Time(0);
	}
}

rule("Squence = 2 게임 시작 시 플레이어")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Squence == 2;
	}

	action
	{
		Event Player.Using_camera = False;
		Set Facing(Event Player, Direction Towards(Event Player, Global.Map_point + Up * 0.500), To World);
		Big Message(Event Player, Custom String("당신은 [{0}]입니다", Event Player.Role));
		Call Subroutine(Role_guide);
	}
}

rule("[서브 루틴] 시민 활성화 직업")
{
	event
	{
		Subroutine;
		Role_able_citizen;
	}

	action
	{
		Global.Citizen_SR_setting = Filtered Array(Global.Citizen_SR_setting, Current Array Element == True);
		For Global Variable(For_Able_role_setting, 0, Count Of(Global.Citizen_SR_setting), 1);
			Global.Able_role_setting[0] = Custom String("{0}{1}", Global.Able_role_setting[0] ? Global.Able_role_setting[0] : Custom String(
				""), Custom String("{0}　", Global.Citizen_SR_setting[Global.For_Able_role_setting]));
			If(!((Global.For_Able_role_setting + 1) % 5) && Global.Citizen_SR_setting[Global.For_Able_role_setting] != Last Of(
				Global.Citizen_SR_setting));
				Global.Able_role_setting[0] = Custom String("{0}{1}", Global.Able_role_setting[0] ? Global.Able_role_setting[0] : Custom String(
					""), Custom String("\r\n"));
			End;
		End;
	}
}

