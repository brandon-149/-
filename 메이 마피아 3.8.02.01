		Event Player.Power_type = 0;
		Event Player.Class = 6;
		Event Player.Role_icon = Hero(둠피스트);
		Event Player.Role_guide = Custom String(
			"[스토킹]\r\n무작위 대상을 스토킹하며\r\n대상의 손을 봅니다\r\n\r\n본인의 생존과 함께 대상이 승리하면\r\n대상의 승리를 빼앗고\r\n단독으로 승리하게 됩니다\r\n\r\n대상이 죽었다면 새로운 대상을 찾습니다");
		Event Player.Tips_and_jokes = Array(Custom String("Tip: 실제로는 스토킹을 해서는 안됩니다!"), Custom String("Tip: 절대 스토킹 대상과 소통하지 마세요"),
			Custom String("Tip: 시민 편을 드는 건 멍청한 짓입니다"));
		Event Player.Tip_or_joke = Random Value In Array(Event Player.Tips_and_jokes);
		Abort If(Global.Time_muchine);
		Event Player.Team = 6;
		Event Player.Team_color = 3;
		Skip If(Array Contains(Global.TF_team, Event Player), 1);
		Modify Global Variable(TF_team, Append To Array, Event Player);
	}
}

rule("스토커 - 스토킹")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.Power == Custom String("스토킹");
		Event Player.Dead == False;
		Global.Time == 6;
	}

	action
	{
		If(!Event Player.Value_for_ability);
			Event Player.Value_for_ability = Random Value In Array(Filtered Array(Global.Live_players,
				Current Array Element.Role != Custom String("기계 인간") && Current Array Element != Event Player));
			Global.Message_request[Count Of(Global.Message_request)] = Array(3, Event Player, Hero Icon String(Event Player.Role_icon),
				Custom String("[{0}]님을 스토킹 합니다", Event Player.Value_for_ability.Name_plate));
		Else If(Event Player.Value_for_ability.Dead);
			Event Player.Value_for_ability = Null;
			Loop;
		End;
	}
}

rule("스토커 - 스토킹 대상 선택")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.Power == Custom String("스토킹");
		Event Player.Dead == False;
		Global.Time == 2;
		Event Player.Value_for_ability == True;
	}

	action
	{
		Event Player.Target = Event Player.Value_for_ability;
		Abort If(!Event Player.Target);
		If(Array Contains(Event Player.Condition, Custom String("사기")));
			Event Player.Ability_target = Random Value In Array(Remove From Array(Global.Live_players, Event Player));
		Else;
			Event Player.Ability_target = Event Player.Target;
		End;
	}
}

