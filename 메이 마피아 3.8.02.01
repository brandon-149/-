		All;
		All;
	}

	condition
	{
		Global.Time == 2;
		Event Player.Power == Custom String("관찰");
		Event Player.Dead == False;
		Is Button Held(Event Player, Button(Jump)) == True;
	}

	action
	{
		If(Array Contains(Event Player.Condition, Custom String("현혹")));
			Global.Message_request[Count Of(Global.Message_request)] = Array(3, Event Player, Hero Icon String(Hero(위도우메이커)), Custom String(
				"오늘은 안돼 자기야♥"));
		Else;
			Stop Camera(Event Player);
			Stop Facing(Event Player);
		End;
	}
}

rule("관찰자 - 관찰 2")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Time == 2;
		Event Player.Power == Custom String("관찰");
		Event Player.Dead == False;
		Is Button Held(Event Player, Button(Jump)) == False;
	}

	action
	{
