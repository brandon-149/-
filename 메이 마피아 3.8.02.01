			Global.Pick_role = Custom String("짐승 인간");
		Else If(Global.Random_value <= 88.889);
			Global.Pick_role = Custom String("사기꾼");
		Else If(Global.Random_value <= 100);
			Global.Pick_role = Custom String("기계 인간");
		End;
		If(!Array Contains(Global.Mafia_SR_setting, Global.Pick_role) || Array Contains(Global.Roles, Global.Pick_role));
