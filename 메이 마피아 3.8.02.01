settings
{
	main
	{
		모드 이름: "메이 마피아"
		설명: "우리가 아는 그 마피아 게임입니다. 자세한 직업 설명은 네이버에 '우비의 워크샵' 또는 유튜브에 '우비 WWOOBEE' 검색 후 참고 해주세요 :) - 버전 3.8.02.02 원작"
	}

	lobby
	{
		경기 음성 대화: 활성화
		최대 관전자 수: 6
	}

	modes
	{
		데스매치
		{
			게임 진행 시간분: 15
			승점: 50
			직접 부활: 비활성화

			enabled maps
			{
				블리자드 월드 겨울 0
				왕의 길 겨울 0
				탐사 기지: 남극 겨울 0
			}
		}

		일반
		{
			게임 모드 시작: 즉시
			무작위 영웅으로 부활: 활성화
			생명력 팩 생성: 비활성화
			실시간 처치 정보: 비활성화
			역할 제한: 팀당 역할별로 2명
			영웅 변경 허용: 비활성화
			적 생명력 막대: 비활성화
			처치 영상: 비활성화
		}
	}

	heroes
	{
		일반
		{
			enabled heroes
			{
				메이
			}
		}
	}
}

