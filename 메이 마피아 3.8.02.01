		Filtered Array(Global.Live_players, Current Array Element.Role == Custom String("의사")).Value_for_ability = True;
		Set Match Time(15);
		Global.Time_for_timer = 1;
		Global.UI = Custom String("{0} 의사의 밤", Hero Icon String(Hero(메르시)));
		Big Message(All Players(All Teams), Custom String("[의사]는 고개를 들어주세요"));
