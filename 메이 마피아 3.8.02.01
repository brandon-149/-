rule("경찰 - 조사")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Time == 5;
		Event Player.Target == True;
		Event Player.Power == Custom String("조사");
	}

	action
	{
		If(Event Player.Target.Dead);
			Global.Message_request[Count Of(Global.Message_request)] = Array(3, Event Player, Hero Icon String(Event Player.Role_icon),
				Custom String("[{0}]님은 이미 죽었습니다", Event Player.Target.Name_plate));
		Else If(Event Player.Ability_target.Role == Custom String("마피아"));
			Global.Message_request[Count Of(Global.Message_request)] = Array(3, Event Player, Hero Icon String(Event Player.Role_icon),
				Custom String("[{0}]님은 [마피아]입니다", Event Player.Target.Name_plate));
		Else;
			Global.Message_request[Count Of(Global.Message_request)] = Array(3, Event Player, Hero Icon String(Event Player.Role_icon),
				Custom String("[{0}]님은 [마피아]가 아닙니다", Event Player.Target.Name_plate));
		End;
	}
}

