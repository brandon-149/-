	}

	action
	{
		Set Match Time(Min(30, Max(15, Count Of(Global.Live_players) * 4)));
		Global.Time_for_timer = 1;
		Global.UI = Custom String("투표 시간");
	}
}

rule("투표권")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Time == 8;
		Event Player.Joined == True;
		Event Player.Dead == False;
		Event Player.Power_able_targets < 20;
	}

	action
	{
		Event Player.Ability_for_voting = Event Player.Head;
		If(Array Contains(Event Player.Condition, Custom String("협박")));
			Global.Message_request[Count Of(Global.Message_request)] = Array(3, Event Player, Hero Icon String(Hero(라인하르트)), Custom String(
				"협박 당했습니다"));
		End;
		If(Event Player.Head == 0);
			Event Player.Done_voting = True;
		End;
	}
}

rule("투표 능력권")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Time == 8;
		Event Player.Joined == True;
		Event Player.Dead == False;
		Event Player.Power_able_targets > 20;
	}

	action
	{
		Event Player.Ability = 1;
	}
}

rule("시간 - 개표 시간")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global.Time == 9;
	}

	action
	{
		Set Match Time(3);
		Global.UI = Custom String("개표 중");
		Global.Live_players.Ability_for_voting = Null;
		Global.Players.Ability = Null;
		Global.Voted_players = Sorted Array(Filtered Array(Global.Players, Count Of(Current Array Element.Votes)), Count Of(
			Current Array Element.Votes) * -1);
	}
}

rule("시간 - 변론 시간")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Time == 10;
		Count Of(Event Player.Votes) > Count Of(Global.Voted_players[1].Votes);
	}

	action
	{
		Set Match Time(15);
		Global.Time_for_timer = 1;
		Global.UI = Custom String("[{0}]님이 변론합니다", Event Player.Name_plate);
		Event Player.P_Yes_or_no = 1;
		If(Event Player.Power_able_left && Event Player.Power == Custom String("자폭"));
			Event Player.Ability_list = Append To Array(False, Remove From Array(Global.Live_players, Event Player));
			Event Player.Ability = 1;
		End;
		Global.Camera_look_at_position = Event Player;
		Remove From Array(Global.Players, Event Player).Camera_type = 2;
		Create Effect(All Players(All Teams), Ring, Color(Orange), Nearest Walkable Position(First Of(Global.Voted_players)),
			0.800 + 0.200 * Sine From Radians(Total Time Elapsed * 1.500), Visible To Position and Radius);
		Global.Voted_effect_ID = Last Created Entity;
	}
}

rule("변론 시간 증가")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Ultimate)) == True;
		Global.Time == 10;
		Event Player.P_Yes_or_no == True;
		Event Player == First Of(Global.Voted_players);
		Match Time >= 1;
	}

	action
	{
		Event Player.P_Yes_or_no -= 1;
		Set Match Time(Match Time + 20);
		Global.Message_request[Count Of(Global.Message_request)] = Array(1, Global.Players, Null, Custom String(
			"[{0}]님이 시간을 [증가]시켰습니다\r\n", Event Player.Name_plate));
		Global.Players.Sound_effect = 3;
	}
}

rule("시간 - 변론 시간 - 동표 일시")
