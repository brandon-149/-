	}

	action
	{
		Set Match Time(3);
		Global.UI = Custom String("투표가 부결되었습니다");
		Global.Time = 14;
	}
}

rule("시간 - 찬반 투표")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Time == 11;
		Event Player == First Of(Global.Voted_players);
	}

	action
	{
		Set Match Time(15);
		Global.Time_for_timer = 1;
		Global.UI = Custom String("찬반 투표를 진행합니다");
		Big Message(All Players(All Teams), Custom String("[{0}]님을 죽이시겠습니까?", Event Player.Name_plate));
		Global.Players.Sound_effect = 4;
		Event Player.P_Yes_or_no = Null;
		If(Event Player.Power == Custom String("자폭"));
			Event Player.Ability = Null;
		End;
	}
}

rule("찬반권")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Time == 11;
		Event Player.Joined == True;
		Event Player.Dead == False;
		Event Player != First Of(Global.Voted_players);
	}

	action
	{
		Event Player.P_Yes_or_no = Event Player.Head;
		If(Array Contains(Event Player.Condition, Custom String("협박")));
			Global.Message_request[Count Of(Global.Message_request)] = Array(3, Event Player, Hero Icon String(Hero(라인하르트)), Custom String(
				"협박 당했습니다"));
		End;
	}
}

rule("찬성 혹은 반대")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		(Is Button Held(Event Player, Button(Ultimate)) || Is Button Held(Event Player, Button(Ability 2))) == True;
		Global.Time == 11;
		Event Player.P_Yes_or_no == True;
	}

	action
	{
		Event Player.P_Yes_or_no -= 1;
		If(Is Button Held(Event Player, Button(Ultimate)));
			Modify Global Variable(G_Yes_or_no, Append To Array, Custom String("Ⅹ "));
			Big Message(Event Player, Custom String("반대 하였습니다"));
			Event Player.Sound_effect = 3;
		Else If(Is Button Held(Event Player, Button(Ability 2)));
			Modify Global Variable(G_Yes_or_no, Append To Array, Custom String("○ "));
			Big Message(Event Player, Custom String("찬성 하였습니다"));
			Event Player.Sound_effect = 2;
		End;
	}
}

rule("찬반 투표 과반수 시간 단축")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		(Count Of(Filtered Array(Global.G_Yes_or_no, Current Array Element == Custom String("○ "))) > Count Of(Remove From Array(
			Global.Live_players, First Of(Global.Voted_players))) / 2 || Count Of(Filtered Array(Global.G_Yes_or_no,
			Current Array Element == Custom String("○ "))) + Count Of(Filtered Array(Global.Live_players,
			Current Array Element.P_Yes_or_no)) + Count Of(Filtered Array(Global.Live_players, Current Array Element.P_Yes_or_no == 2))
			<= Count Of(Remove From Array(Global.Live_players, First Of(Global.Voted_players))) / 2) == True;
		Global.Time == 11;
		Match Time > 3;
		Match Time <= 10;
	}

	action
	{
		Global.Message_request[Count Of(Global.Message_request)] = Array(1, Global.Players, Null, Custom String(
			"이미 과반수를 넘겨 투표가 곧 종료됩니다\r\n"));
		Set Match Time(3);
	}
}

rule("시간 - 찬반 투표 결과 발표")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global.Time == 12;
	}

	action
	{
		Global.UI = Custom String("찬반 투표 결과");
		Global.Camera_look_at_position = First Of(Global.Voted_players);
		Global.Players.Camera_type = 2;
		Create In-World Text(All Players(All Teams), Global.Execute_players ? Global.Execute_players : Custom String(""), First Of(
			Global.Voted_players).Player_position + Up * 1.500 + Direction Towards(First Of(Global.Voted_players)
			.Player_position + Up * 1.500, Global.Map_point + Up * 1.500), 4, Do Not Clip, Visible To Position and String, Color(흰색),
			Default Visibility);
		Global.World_text_ID = Last Text ID;
		While(Count Of(Global.G_Yes_or_no) < Count Of(Remove From Array(Global.Live_players, First Of(Global.Voted_players))));
			Modify Global Variable(G_Yes_or_no, Append To Array, Custom String("－ "));
		End;
		Global.G_Yes_or_no = Randomized Array(Global.G_Yes_or_no);
		For Global Variable(For_Able_role_setting, 0, Count Of(Global.G_Yes_or_no), 1);
			Wait(1, Ignore Condition);
			Global.Voter_list = Empty Array;
			For Global Variable(For_Execute, 0, Count Of(Global.G_Yes_or_no), 1);
				Global.Voter_list = Custom String("{0}{1}", Global.Voter_list ? Global.Voter_list : Custom String(""),
					Global.For_Execute <= Global.For_Able_role_setting ? Custom String("{0}", Global.G_Yes_or_no[Global.For_Execute])
					: Custom String("　 "));
			End;
			Global.Execute_players = Global.Voter_list;
			Play Effect(All Players(All Teams), Ring Explosion Sound, Color(흰색), Global.Map_point, 40);
		End;
		Global.Message_request[Count Of(Global.Message_request)] = Array(1, Global.Players, Icon String(Checkmark), Custom String(
			"{0}명 중 반대: {1}　찬성: {2}", Count Of(Remove From Array(Global.Live_players, First Of(Global.Voted_players))), Count Of(
			Filtered Array(Global.G_Yes_or_no, Current Array Element == Custom String("Ⅹ "))), Count Of(Filtered Array(Global.G_Yes_or_no,
			Current Array Element == Custom String("○ ")))));
		Wait(2, Ignore Condition);
		If(Count Of(Filtered Array(Global.G_Yes_or_no, Current Array Element == Custom String("○ "))) > Count Of(Remove From Array(
			Global.Live_players, First Of(Global.Voted_players))) / 2);
			First Of(Global.Voted_players).Vote_dead = True;
		Else;
			Global.Message_request[Count Of(Global.Message_request)] = Array(1, Global.Players, Icon String(Stop), Custom String("반대됨",
				First Of(Global.Voted_players).Name_plate));
			Wait(3, Ignore Condition);
			Set Match Time(1);
		End;
	}
}

rule("투표 사망")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.Vote_dead == True;
	}

	action
	{
		If(Event Player.Power_able_left && Event Player.Power == Custom String("높으신 분"));
			Skip If(Array Contains(Event Player.Condition, Custom String("현혹")), 3);
			Global.Message_request[Count Of(Global.Message_request)] = Array(1, Global.Players, Icon String(Stop), Custom String(
				"[{0}]님은 처형할 수 없습니다", Event Player.Name_plate));
			Event Player.Power_able_left -= 1;
			Skip(1);
			Skip(1);
		Else;
			Event Player.Dead = 1;
			Global.Message_request[Count Of(Global.Message_request)] = Array(1, All Players(All Teams), Icon String(Skull), Custom String(
				"[{0}]님이 처형 당했습니다", Event Player.Name_plate));
			If(Global.Game_mode == Custom String("클래식") || (Global.Game_mode == Custom String("노말") && Global.Count_of_players <= 6));
				Wait(3, Ignore Condition);
				Big Message(All Players(All Teams), Custom String("[{0}]님은 [마피아]{1}", Event Player.Name_plate, Event Player.Role == Custom String(
					"마피아") ? Custom String("였습니다") : Custom String("가 아니였습니다")));
			End;
			If(Event Player.Power == Custom String("자폭"));
				Skip If(Array Contains(Event Player.Condition, Custom String("현혹")) || Event Player.Ability_target.Role == Custom String("기계 인간"),
					6);
				Event Player.Power_able_left -= 1;
				Global.Camera_look_at_position = Event Player.Ability_target;
				Global.Players.Camera_type = 2;
				Wait(3, Ignore Condition);
				Event Player.Ability_target.Dead = 1;
				Global.Message_request[Count Of(Global.Message_request)] = Array(1, All Players(All Teams), Hero Icon String(Hero(파라)),
					Custom String("[{0}]님과 자폭하였습니다", Event Player.Ability_target.Name_plate));
			End;
		End;
		Wait(3, Ignore Condition);
		Set Match Time(1);
		Event Player.Vote_dead = Null;
	}
}

rule("시간 - 저녁 - 변수 정리")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global.Time == 13;
	}

	action
	{
		Set Match Time(3);
		Global.UI = Custom String("하루가 저물어갑니다");
		Destroy In-World Text(Global.World_text_ID);
		Global.Execute_players = Empty Array;
		Destroy Effect(Global.Voted_effect_ID);
	}
}

rule("[서브 루틴] 살해 혹은 살인")
{
	event
	{
		Subroutine;
		Murder;
	}

	action
	{
		If(Array Contains(Event Player.Condition, Custom String("희생")));
			Call Subroutine(Sacrifice);
		Else If(Event Player.Power == Custom String("자폭") && Event Player.Power_able_left);
			Call Subroutine(Suicide_bombing);
		Else If(Event Player.Power == Custom String("방어술") && Event Player.Power_able_left);
			Call Subroutine(Defense_against);
		Else;
			Skip If(Array Contains(Event Player.Condition, Custom String("치유")), 1);
			Modify Global Variable(Execute_players, Append To Array, Event Player);
		End;
	}
}

