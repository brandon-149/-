rule("도둑 - 절도")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Time == 8;
		Event Player.Power == Custom String("절도");
		Event Player.Target == True;
	}

	action
	{
		If(Event Player.Target.Team == 6);
			If(Event Player.Target.Role == Custom String("사이비 교주"));
				Modify Global Variable(TF_team, Append To Array, Event Player);
				Global.Message_request[Count Of(Global.Message_request)] = Array(3, Event Player, Hero Icon String(Event Player.Role_icon),
					Custom String("[{0}]님을 따릅니다", Event Player.Target.Name_plate));
			Else;
				Global.Message_request[Count Of(Global.Message_request)] = Array(3, Event Player, Hero Icon String(Event Player.Role_icon),
					Custom String("[{0}]님은 훔칠 수 없습니다", Event Player.Target.Name_plate));
			End;
		Else;
			Event Player.Head = Event Player.Ability_target.Head;
			Event Player.Power = Event Player.Ability_target.Power;
			Event Player.Power_able_left = Event Player.Ability_target.Power_able_left;
			Event Player.Power_able_targets = Event Player.Ability_target.Power_able_targets;
			Event Player.Power_type = Event Player.Ability_target.Power_type;
			Global.Message_request[Count Of(Global.Message_request)] = Array(3, Event Player, Hero Icon String(Event Player.Role_icon),
				Custom String("[{0}]님의 [{1}]를 훔쳤습니다", Event Player.Target.Name_plate, Event Player.Ability_target.Power));
		End;
	}
}

rule("도둑 - 원상 복귀")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.Role == Custom String("도둑");
		Event Player.Power != Custom String("절도");
		Global.Time == 7;
	}

	action
	{
		If(Array Contains(Event Player.Condition, Custom String("협박")));
			Event Player.Head = 0;
		Else;
			Event Player.Head = 1;
		End;
		Event Player.Power = Custom String("절도");
		Event Player.Power_able_left = 1;
		Event Player.Power_able_targets = 22;
		Event Player.Power_type = 1;
	}
}

