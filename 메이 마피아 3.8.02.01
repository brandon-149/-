rule("성직자 - 부활")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Time == 3;
		Event Player.Target == True;
		Event Player.Power == Custom String("부활");
	}

	action
	{
		If(Filtered Array(Event Player.Condition, Array Contains(Global.Power_array[0], Current Array Element)) && !Array Contains(
			Event Player.Condition, Custom String("치유")) && !Array Contains(Event Player.Condition, Custom String("희생")));
			Event Player.P_Message_request[Count Of(Event Player.P_Message_request)] = Array(3, Event Player, Hero Icon String(
				Event Player.Role_icon), Custom String("되살리기 전날 당신은 죽었습니다"));
		Else If(Event Player.Ability_target.Role == Custom String("기계 인간"));
		Else If(!Array Contains(Event Player.Ability_target.Condition, Custom String("성불")));
			Event Player.Ability_target.Condition = Event Player.Power;
		Else;
			Event Player.P_Message_request[Count Of(Event Player.P_Message_request)] = Array(3, Event Player, Hero Icon String(
				Event Player.Role_icon), Custom String("[{0}]님을 되살릴 수 없습니다", Event Player.Ability_target.Name_plate));
		End;
	}
}

