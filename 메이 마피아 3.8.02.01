rule("테스트 모드 더미 봇 생성")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global.Mode_setting[0] == True;
	}

	action
	{
		While(Count Of(Filtered Array(All Players(All Teams), Is Dummy Bot(Current Array Element)))
			< Global.Mode_setting[4] && Number Of Players(All Teams) < 12);
			Create Dummy Bot(Random Value In Array(Filtered Array(모든 영웅, !Is Hero Being Played(Current Array Element, All Teams))), All Teams,
				-1, Global.Map_point + Vector(Random Integer(-4, 4), 0, Random Integer(-4, 4)), Null);
			Wait(0.500, Ignore Condition);
		End;
	}
}

rule("테스트 모드 시간 건너뛰기")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Mode_setting[0] == True;
		Is Button Held(Host Player, Button(Interact)) == True;
	}

	action
	{
		disabled Ray Cast Hit Player(Eye Position(Event Player), Eye Position(Event Player) + Facing Direction Of(Event Player) * 10, All Players(
			All Teams), Event Player, True).Dead = Random Value In Array(Array(1, 2, 0));
		Set Match Time(1);
	}
}

disabled rule("승리 위치 테스트")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Is Button Held(Host Player, Button(Jump)) == True;
	}

	action
	{
		Global.Winner_list = Filtered Array(Global.Players, Current Array Element.Team == 1);
		Global.UI = Custom String("시민 팀 승리");
		Global.Loser_list = Remove From Array(Global.Players, Global.Winner_list);
		Global.Squence = 3;
	}
}

rule("YOUTUBE [우비 WWOOBEE]")
{
	event
	{
		Ongoing - Global;
	}

	action
	{
		Disable Built-In Game Mode Completion;
		Disable Built-In Game Mode Music;
		Disable Built-In Game Mode Scoring;
	}
}

rule("게임 사용자 설정")
{
	event
	{
		Ongoing - Global;
	}

	action
	{
		"게임 모드 설정"
		Global.Game_mode = Workshop Setting Combo(Custom String("게임 모드"), Custom String(
			"게임 모드 (하드 모드는 5개 이상의 시민 특수 직업과 각 1개 이상의 마피아 특수 직업, 3 세력을 필요로 합니다)"), 0, Array(Custom String("노말 모드"), Custom String("클래식 모드"),
			Custom String("하드 모드")), 0);
		disabled Global.Mode_setting[3] = Workshop Setting Toggle(Custom String("게임 모드"), Custom String("스트리머 모드 (미구현)"), False, 3);
		Global.Mode_setting[5] = Workshop Setting Integer(Custom String("시민 특수 직업"), Custom String("　도굴꾼 타임머신 도굴 확률"), 20, 0, 100, 15);
		Global.Mode_setting[6] = Workshop Setting Toggle(Custom String("시민 특수 직업"), Custom String("　테러리스트 투표시간 능력 활성화"), True, 21);
		"시민 특수 직업"
		Global.Citizen_SR_setting[0] = Workshop Setting Toggle(Custom String("시민 특수 직업"), Custom String("탐정"), True, 11) ? Custom String(
			"탐정") : Null;
		Global.Citizen_SR_setting[1] = Workshop Setting Toggle(Custom String("시민 특수 직업"), Custom String("영매"), True, 12) ? Custom String(
			"영매") : Null;
		Global.Citizen_SR_setting[2] = Workshop Setting Toggle(Custom String("시민 특수 직업"), Custom String("건달"), True, 13) ? Custom String(
			"건달") : Null;
		Global.Citizen_SR_setting[3] = Workshop Setting Toggle(Custom String("시민 특수 직업"), Custom String("도굴꾼"), True, 14) ? Custom String(
			"도굴꾼") : Null;
		Global.Citizen_SR_setting[4] = Workshop Setting Toggle(Custom String("시민 특수 직업"), Custom String("기자"), True, 16) ? Custom String(
			"기자") : Null;
		Global.Citizen_SR_setting[5] = Workshop Setting Toggle(Custom String("시민 특수 직업"), Custom String("정치인"), True, 17) ? Custom String(
			"정치인") : Null;
		Global.Citizen_SR_setting[6] = Workshop Setting Toggle(Custom String("시민 특수 직업"), Custom String("성직자"), True, 18) ? Custom String(
			"성직자") : Null;
		Global.Citizen_SR_setting[7] = Workshop Setting Toggle(Custom String("시민 특수 직업"), Custom String("군인"), True, 19) ? Custom String(
			"군인") : Null;
		Global.Citizen_SR_setting[8] = Workshop Setting Toggle(Custom String("시민 특수 직업"), Custom String("테러리스트"), True, 20)
			? Custom String("테러리스트") : Null;
		Global.Citizen_SR_setting[9] = Workshop Setting Toggle(Custom String("시민 특수 직업"), Custom String("흑기사"), True, 22) ? Custom String(
			"흑기사") : Null;
		Global.Citizen_SR_setting[10] = Workshop Setting Toggle(Custom String("시민 특수 직업"), Custom String("관찰자"), True, 23) ? Custom String(
			"관찰자") : Null;
		"마피아 특수 직업"
		Global.Mafia_SR_setting[0] = Workshop Setting Toggle(Custom String("마피아 특수 직업"), Custom String("스파이"), True, 31) ? Custom String(
			"스파이") : Null;
		Global.Mafia_SR_setting[1] = Workshop Setting Toggle(Custom String("마피아 특수 직업"), Custom String("마담"), True, 32) ? Custom String(
			"마담") : Null;
		Global.Mafia_SR_setting[2] = Workshop Setting Toggle(Custom String("마피아 특수 직업"), Custom String("도둑"), True, 33) ? Custom String(
			"도둑") : Null;
		Global.Mafia_SR_setting[3] = Workshop Setting Toggle(Custom String("마피아 특수 직업"), Custom String("짐승 인간"), True, 34) ? Custom String(
			"짐승 인간") : Null;
		Global.Mafia_SR_setting[4] = Workshop Setting Toggle(Custom String("마피아 특수 직업"), Custom String("사기꾼"), True, 35) ? Custom String(
			"사기꾼") : Null;
		Global.Mafia_SR_setting[5] = Workshop Setting Toggle(Custom String("마피아 특수 직업"), Custom String("기계 인간"), True, 36) ? Custom String(
			"기계 인간") : Null;
		"3 세력"
		Global.TF_setting[0] = Workshop Setting Toggle(Custom String("3 세력"), Custom String("살인마"), True, 51) ? Custom String("살인마")
			: Null;
		Global.TF_setting[1] = Workshop Setting Toggle(Custom String("3 세력"), Custom String("스토커"), True, 52) ? Custom String("스토커")
			: Null;
		Global.TF_setting[2] = Workshop Setting Toggle(Custom String("3 세력"), Custom String("사이비 교주"), True, 53) ? Custom String("사이비 교주")
			: Null;
		"특직 모드 인원수 충족"
		If(Count Of(Filtered Array(Global.Citizen_SR_setting, Current Array Element)) < 5 && Count Of(Filtered Array(
			Global.Mafia_SR_setting, Current Array Element)) < 1 && Count Of(Filtered Array(Global.TF_setting, Current Array Element))
			< 1);
			Global.Game_mode = 0;
		End;
		"모드 설정"
		If(Global.Game_mode == 0);
			Global.Game_mode = Custom String("노말");
		Else If(Global.Game_mode == 1);
			Global.Game_mode = Custom String("클래식");
		Else If(Global.Game_mode == 2);
			Global.Game_mode = Custom String("하드");
		End;
		"테스트 모드"
		Global.Mode_setting[0] = Workshop Setting Toggle(Custom String("테스트 모드"), Custom String("테스트 모드 활성화"), False, 90);
		Global.Mode_setting[4] = Workshop Setting Integer(Custom String("테스트 모드"), Custom String("테스트 모드 더미봇 개수"), 0, 0, 12, 91);
		Skip If(Global.Mode_setting[0], 1);
		Disable Inspector Recording;
	}
}

rule("글로벌 변수 설정")
{
	event
	{
		Ongoing - Global;
	}

	action
	{
		Global.Dead_players = Empty Array;
		Global.Time_limit = 13;
		Global.Message_left_time = 10;
		Global.Message_sorted_number = -2;
		Global.Message_text_ID = Empty Array;
		Global.Message_time = Empty Array;
		Global.Citizen_team = Empty Array;
		Global.Mafia_team = Empty Array;
		Global.TF_team = Empty Array;
		Global.Power_array[0] = Array(Custom String("살해"), Custom String("살인"));
		Global.Power_array[1] = Array(Custom String("짐승 인간"), Custom String("기계 인간"));
		Global.Power_array[2] = Array(Custom String("특종"), Custom String("부활"));
		Global.UI_small = Custom String("플레이 최소 인원 6명");
		Global.UI = Custom String("메이 마피아");
		Global.UI_color = Color(흰색);
		"TOP"
		Create HUD Text(All Players(All Teams), Null, Null, Global.Day ? (Round To Integer(Total Time Elapsed / 10, Down)
			% 2 ? Custom String("{0} - {1}", Custom String("{0} 모드", Global.Game_mode), Custom String("{0}번째 {1}", Global.Day,
			Global.Time_for_night_morning_else == 1 ? Custom String("밤") : Custom String("낮"))) : Custom String("{0}명 중 {1}명 생존",
			Global.Count_of_players, Count Of(Global.Live_players))) : (Global.Squence ? Global.UI_small : Custom String(
			"{0} 현재 인원: {1} / 최소 인원: {2}", Hero Icon String(Hero(메이)), Count Of(Filtered Array(All Players(All Teams),
			Current Array Element.Joined)), 6)), Top, -10, Color(흰색), Color(흰색), Color(흰색), Visible To and String, Default Visibility);
		Create HUD Text(All Players(All Teams), Global.UI, Null, Null, Top, -9, Global.Time_for_night_morning_else == 1 ? Color(Purple) : (
			Global.Time_for_night_morning_else == 2 ? Color(Yellow) : (Global.Time_for_night_morning_else == 3 ? Color(Orange) : Color(
			흰색))), Color(흰색), Color(흰색), Visible To String and Color, Default Visibility);
		Global.Ghost_tips = Array(Custom String("죽은 자는 말이 없습니다"), Custom String("영웅은 죽지 않아요! 너만 빼고!"), Custom String(
			"살아있는 시민이 죽은 경찰보다 훨씬 가치 있다"), Custom String("당신의 죽음이 더욱 값이 있기를..."), Custom String("Tip: 낮에는 영매와 소통할 수 있습니다"));
	}
}

rule("맵 (일반)")
{
	event
	{
		Ongoing - Global;
	}

	action
	{
		If(Current Map == Map(워크샵 섬 밤));
			Global.Map_point = Vector(0, 0, 0);
			Global.Location = Array(Vector(39.550, 52.550, 152.280), Vector(37.140, 115.400, 222.690), Vector(0, 0, -9), Left, Vector(0, 0,
				-16), Left, Vector(0, 3, -5));
		Else If(Current Map == Map(네팔 마을));
			Global.Map_point = Vector(-195, -94, 0);
			Global.Location = Array(Vector(-181.850, -91.240, 67.080), Vector(-193.330, -76.940, 82.310), Vector(-174.800, -99.050, -77.120),
				Left, Vector(-174.690, -99.090, -68.940), Left, Vector(-175.080, -95.050, -84.200));
		Else;
		End;
	}
}

rule("맵 (크리스마스)")
{
	event
	{
		Ongoing - Global;
	}

	action
	{
		If(Current Map == Map(탐사 기지: 남극 겨울));
			Global.Map_point = Vector(20, 9, 0.070);
			Global.Location = Array(Vector(-0.750, 19.620, -20.030), Vector(-7.670, 31.880, -40.830), Vector(6.110, 6.890, -35.480), Vector(
				-0.950, 0.050, -0.310), Vector(7.200, 6.920, -38.520), Vector(-0.960, 0.050, -0.270), Vector(4.440, 12.350, -29.460));
		Else If(Current Map == Map(왕의 길 겨울));
			Global.Map_point = Vector(-18.970, -0.120, -33.620);
			Global.Location = Array(Vector(-6.720, 44.030, -33.290), Vector(-22.020, 63.590, -37.010), Vector(-148.780, -2.850, 24.250),
				Vector(0.200, 0, 0.980), Vector(-151.050, -2.820, 24.610), Vector(0.230, 0, 0.970), Vector(-143, 2.540, 23.240));
		Else If(Current Map == Map(블리자드 월드 겨울));
			Global.Map_point = Vector(-54.470, -0.390, 110.400);
			Global.Location = Array(Vector(-7.080, 16.640, 53.790), Vector(2.450, 27.240, 43.190), Vector(2.930, 1.900, 73.100), Vector(-1, 0,
				0), Vector(2.950, 2, 69.610), Vector(-1, 0, 0), Vector(3.040, 8.140, 78.680));
		End;
	}
}

