rule("시간 - 낮 - 토론 및 조커의 폭탄 교환")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global.Time == 6;
	}

	action
	{
		Set Match Time(180);
		Global.Time_for_timer = 1;
		Global.UI = Custom String("토론 시간");
		Modify Player Variable(Global.Players, Condition, Remove From Array By Value, Custom String("살해"));
		Modify Player Variable(Global.Players, Condition, Remove From Array By Value, Custom String("치유"));
		Skip If(Global.Game_mode == Custom String("클래식"), 5);
		Modify Player Variable(Global.Players, Condition, Remove From Array By Value, Custom String("부활"));
		Modify Player Variable(Global.Players, Condition, Remove From Array By Value, Custom String("희생"));
		Modify Player Variable(Global.Players, Condition, Remove From Array By Value, Custom String("현혹"));
		Modify Player Variable(Global.Players, Condition, Remove From Array By Value, Custom String("사기"));
		Modify Player Variable(Global.Players, Condition, Remove From Array By Value, Custom String("살인"));
	}
}

rule("낮 - 개인 변수 정리")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Time == 6;
		Event Player.Joined == True;
	}

	action
	{
		Skip If(Event Player.Dead, 1);
		Event Player.P_Yes_or_no = 1;
		Allow Button(Event Player, Button(Jump));
		Allow Button(Event Player, Button(Crouch));
	}
}

rule("시간 단축 혹은 증가")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		(Is Button Held(Event Player, Button(Ultimate)) || Is Button Held(Event Player, Button(Ability 2))) == True;
		Global.Time == 6;
		Event Player.P_Yes_or_no == True;
		Match Time >= 1;
	}

	action
	{
		Event Player.P_Yes_or_no -= 1;
		If(Is Button Held(Event Player, Button(Ultimate)));
			Set Match Time(Match Time + Min(30, 180 / Count Of(Global.Live_players)));
			Global.Message_request[Count Of(Global.Message_request)] = Array(1, Global.Players, Null, Custom String(
				"[{0}]님이 시간을 [증가]시켰습니다\r\n", Event Player.Name_plate));
			Global.Players.Sound_effect = 3;
		Else If(Is Button Held(Event Player, Button(Ability 2)));
			Set Match Time(Match Time - 180 / Count Of(Global.Live_players));
			Global.Message_request[Count Of(Global.Message_request)] = Array(1, Global.Players, Null, Custom String(
				"[{0}]님이 시간을 [단축]시켰습니다\r\n", Event Player.Name_plate));
			Global.Players.Sound_effect = 3;
		End;
	}
}

rule("시간 - 오후 - 변수 정리 및 투표 알림")
