rule("시간 - 밤 - 스파이의 밤 - 클래식")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global.Time == 2;
		Global.Night_time_for_classic == 4;
		Global.Count_of_players >= 9;
	}

	action
	{
		If(Array Contains(Global.Mafia_team, Filtered Array(Global.Players, Current Array Element.Role == Custom String("스파이"))));
			Wait(3, Ignore Condition);
		Else;
			Global.Mafia_team.Value_for_ability = True;
			Skip If(Global.Mafia_icon_ID == Null, 1);
			Call Subroutine(Mafia_icon);
			Wait(3, Ignore Condition);
			Filtered Array(Global.Live_players, Current Array Element.Role == Custom String("스파이")).Value_for_ability = True;
		End;
		Set Match Time(15);
		Global.Time_for_timer = 1;
		Global.UI = Custom String("{0} 스파이의 밤", Hero Icon String(Hero(솜브라)));
		Big Message(All Players(All Teams), Custom String("[스파이]는 고개를 들어주세요"));
	}
}

rule("시간 - 새벽 - 변수 정리 및 낮 알림")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global.Time == 3;
	}

	action
	{
		If(Global.Game_mode == Custom String("클래식"));
			If(Global.Count_of_players < 9 || Array Contains(Global.Mafia_team, Filtered Array(Global.Players,
				Current Array Element.Role == Custom String("스파이"))));
				Global.Mafia_team.Value_for_ability = True;
			Else;
				Filtered Array(Global.Live_players, Current Array Element.Role == Custom String("스파이")).Value_for_ability = True;
			End;
		End;
		Set Match Time(3);
		Global.Time_for_night_morning_else = 2;
		Global.UI = Custom String("날이 밝아옵니다");
		Big Message(All Players(All Teams), Custom String("날이 밝아옵니다"));
		Global.Players.Ability = Null;
		Skip If(Global.Mafia_icon_ID == Null, 1);
		Call Subroutine(Mafia_icon);
	}
}

rule("새벽에 마피아 다시 수면")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Time == 3;
		Global.Game_mode != Custom String("클래식");
		Array Contains(Global.Mafia_team, Event Player) == True;
	}

	action
	{
		Event Player.Camera_type = 1;
		Start Facing(Event Player, Direction From Angles(Horizontal Angle From Direction(Direction Towards(Event Player,
			Global.Map_point)), 85), 150, To World, Direction and Turn Rate);
	}
}

rule("시간 - 사망 결과")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global.Time == 4;
	}

	action
	{
		Global.UI = Custom String("사망 결과");
		If(Global.Execute_players == Empty Array);
			If(Random Integer(1, 100) <= 20);
				Global.Camera_look_at_position = Random Value In Array(Global.Live_players);
				Global.Players.Camera_type = 2;
				Wait(3, Ignore Condition);
				Global.Message_request[Count Of(Global.Message_request)] = Array(1, Global.Players, Icon String(Skull), Custom String(
					"간밤에 [{0}]님{1}", Global.Camera_look_at_position.Name_plate, Random Value In Array(Array(Custom String("이 죽지 않았습니다")))));
				Wait(2, Ignore Condition);
			Else;
				Global.Message_request[Count Of(Global.Message_request)] = Array(1, Global.Players, Icon String(Happy), Custom String(
					"간밤에는 아무도 죽지 않았습니다"));
				Wait(2, Ignore Condition);
			End;
		Else;
			Global.Execute_players = Randomized Array(Global.Execute_players);
			For Global Variable(For_Execute, 0, Count Of(Global.Execute_players), 1);
				Global.Camera_look_at_position = Global.Execute_players[Global.For_Execute];
				Global.Players.Camera_type = 2;
				Wait(3, Ignore Condition);
				Global.Execute_players[Global.For_Execute].Dead = 2;
				Global.Message_request[Count Of(Global.Message_request)] = Array(1, Global.Players, Icon String(Skull), Custom String(
					"간밤에 [{0}]님이 죽었습니다", Global.Execute_players[Global.For_Execute].Name_plate));
				Wait(2, Ignore Condition);
			End;
			If(Random Integer(1, 100) <= 10);
				Global.Camera_look_at_position = Random Value In Array(Global.Live_players);
				Global.Players.Camera_type = 2;
				Wait(3, Ignore Condition);
				Global.Message_request[Count Of(Global.Message_request)] = Array(1, Global.Players, Icon String(Skull), Custom String(
					"간밤에 [{0}]님{1}", Global.Camera_look_at_position.Name_plate, Random Value In Array(Array(Custom String("이 죽지 않았습니다")))));
				Wait(2, Ignore Condition);
			End;
		End;
		If(Filtered Array(Global.Dead_players, Array Contains(Current Array Element.Condition, Custom String("부활"))));
			For Global Variable(For_Execute, 0, Count Of(Filtered Array(Global.Players, Array Contains(Current Array Element.Condition,
				Custom String("부활")))), 1);
				Global.Camera_look_at_position = Filtered Array(Global.Players, Array Contains(Current Array Element.Condition, Custom String(
					"부활")))[Global.For_Execute];
				Global.Players.Camera_type = 2;
				Wait(3, Ignore Condition);
				Filtered Array(Global.Players, Array Contains(Current Array Element.Condition, Custom String("부활")))
					[Global.For_Execute].Dead = Null;
				Global.Message_request[Count Of(Global.Message_request)] = Array(1, Global.Players, Icon String(Skull), Custom String(
					"[{0}]님이 되살아났습니다", Filtered Array(Global.Players, Array Contains(Current Array Element.Condition, Custom String("부활")))
					[Global.For_Execute].Name_plate));
				Wait(2, Ignore Condition);
			End;
		End;
		Wait(1, Ignore Condition);
		Set Match Time(1);
		Global.Execute_players = Empty Array;
	}
}

