rule("사이비 교주 - 포교")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Time == 5;
		Event Player.Power == Custom String("포교");
		Event Player.Target == True;
	}

	action
	{
		If(Event Player.Ability_target.Class == 4);
		Else If(Event Player.Ability_target.Role == Custom String("기계 인간"));
		Else If(Event Player.Ability_target.Role == Custom String("짐승 인간"));
		Else If(Event Player.Ability_target.Power == Custom String("부활"));
			Event Player.Ability_target.Sound_effect = 1;
			Global.Message_request[Count Of(Global.Message_request)] = Array(1, Event Player.Ability_target, Hero Icon String(
				Event Player.Role_icon), Custom String("[{0}]님이 당신에게 [포교]를 시도했습니다", Event Player.Name_plate));
		Else;
			Modify Global Variable(TF_team, Append To Array, Event Player.Ability_target);
			Global.Players.Sound_effect = 1;
			Global.Message_request[Count Of(Global.Message_request)] = Array(1, Global.Players, Hero Icon String(Event Player.Role_icon),
				Custom String("누군가 포교를 당했습니다"));
		End;
	}
}

rule("[서브 루틴] 머릿수 잡기")
{
	event
	{
		Subroutine;
		Count_head;
	}

	action
	{
		Global.Count_of_citizen_team = Null;
		For Global Variable(For_Count_team, 0, Count Of(Filtered Array(Global.Citizen_team, !Current Array Element.Dead)), 1);
			Global.Count_of_citizen_team += Filtered Array(Global.Citizen_team, !Current Array Element.Dead)[Global.For_Count_team].Head;
		End;
		Global.Count_of_mafia_team = Null;
		For Global Variable(For_Count_team, 0, Count Of(Filtered Array(Global.Mafia_team, !Current Array Element.Dead)), 1);
			Global.Count_of_mafia_team += Filtered Array(Global.Mafia_team, !Current Array Element.Dead)[Global.For_Count_team].Head;
		End;
		Global.Count_of_TF_team = Null;
		For Global Variable(For_Count_team, 0, Count Of(Filtered Array(Global.TF_team, !Current Array Element.Dead)), 1);
			Global.Count_of_TF_team += Filtered Array(Global.TF_team, !Current Array Element.Dead)[Global.For_Count_team].Head;
		End;
	}
}

rule("3인칭 시야 변경")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Ability 1)) == True;
		Event Player.Using_camera == False;
		Event Player.Dead == False;
		Global.Squence == 2;
	}

	action
	{
		Stop Camera(Event Player);
		If(!Event Player.Third_person_look);
			Start Camera(Event Player, Ray Cast Hit Position(Eye Position(Event Player), Eye Position(Event Player) + Facing Direction Of(
				Event Player) * -2 + Up, All Players(All Teams), Event Player, True), Eye Position(Event Player) + Facing Direction Of(
				Event Player) * 10, 15);
		End;
		Event Player.Third_person_look = !Event Player.Third_person_look;
	}
}

rule("사운드 이펙트")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.Sound_effect == True;
	}

	action
	{
		"능력 사용"
		If(Event Player.Sound_effect == 1);
			Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player.Sound_position, 40);
		"긍정"
		Else If(Event Player.Sound_effect == 2);
			Play Effect(Event Player, Buff Explosion Sound, Color(흰색), Event Player.Sound_position, 40);
		"부정"
		Else If(Event Player.Sound_effect == 3);
			Play Effect(Event Player, Ring Explosion Sound, Color(흰색), Event Player.Sound_position, 40);
		"총소리"
		Else If(Event Player.Sound_effect == 4);
			Play Effect(Event Player, Explosion Sound, Color(흰색), Event Player.Sound_position, 60);
		"픽 넘기기"
		Else If(Event Player.Sound_effect == 5);
			Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player.Sound_position, 20);
		End;
		Event Player.Sound_effect = Null;
	}
}

rule("[서브 루틴] 마피아 아이콘 생성")
{
	event
	{
		Subroutine;
		Mafia_icon;
	}

	action
	{
		If(Global.Mafia_icon_ID == Null);
			Create Icon(Global.Mafia_team, Filtered Array(Global.Players, Array Contains(Current Array Element.Condition, Custom String(
				"살해"))), Skull, Visible To and Position, Color(Red), True);
			Global.Mafia_icon_ID = Last Created Entity;
			Create Effect(Global.Mafia_team, Ring, Color(Red), Nearest Walkable Position(Filtered Array(Global.Players, Array Contains(
				Current Array Element.Condition, Custom String("살해")))), 0.800 + 0.200 * Sine From Radians(Total Time Elapsed * 1.500),
				Visible To Position and Radius);
			Global.Mafia_effect_ID = Last Created Entity;
		Else;
			Destroy Icon(Global.Mafia_icon_ID);
			Global.Mafia_icon_ID = Null;
			Destroy Effect(Global.Mafia_effect_ID);
			Global.Mafia_effect_ID = Null;
		End;
	}
}

rule("살해 혹은 살인")
{
    event
    {
        Ongoing - Each Player;
        All;
        All;
    }

    condition
    {
        Global.Time == 3;
        Filtered Array(Event Player.Condition, Array Contains(Global.Power_array[0], First Of(Current Array Element))) == True;
    }

    action
    {
        If(Filtered Array(Event Player.Condition, Array Contains(Current Array Element, Custom String("살해"))) && Filtered Array(Event Player.Condition, Array Contains(Current Array Element, Custom String("살인"))));
            If(Array Contains(Global.Power_array[1], Event Player.Role));
                Modify Global Variable(Mafia_team, Append To Array, Event Player);
            End;
            If(Event Player.Role == Custom String("기계 인간"));
            Else If(Filtered Array(Event Player.Condition, Array Contains(Current Array Element, Custom String("희생"))));
                Call Subroutine(Sacrifice);
            Else If(Event Player.Power == Custom String("자폭") && Event Player.Power_able_left);
                Call Subroutine(Suicide_bombing);
            Else;
                Modify Global Variable(Execute_players, Append To Array, Event Player);
            End;
        Else If(Filtered Array(Event Player.Condition, Array Contains(Current Array Element, Custom String("살해"))));
            If(Array Contains(Global.Power_array[1], Event Player.Role));
                Modify Global Variable(Mafia_team, Append To Array, Event Player);
            Else If(Event Player.Role == Custom String("살인마"));
            Else;
                Call Subroutine(Murder);
            End;
        Else If(Filtered Array(Event Player.Condition, Array Contains(Current Array Element, Custom String("살인"))));
            If(Array Contains(Global.Mafia_team, Event Player));
            Else If(Event Player.Role == Custom String("기계 인간"));
            Else;
                Call Subroutine(Murder);
            End;
        End;
    }
}

rule("능력 사용 대상 잡기")
{
	event
	{
		Subroutine;
		Get_ability_target;
	}

	action
	{
		Abort If(!Event Player.Target);
		If(Array Contains(Event Player.Condition, Custom String("사기")));
			Event Player.Ability_target = Random Value In Array(Remove From Array(Event Player.Ability_list, False));
		Else;
			Event Player.Ability_target = Event Player.Target;
		End;
	}
}

rule("스파이 - 해킹")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Time == 5;
		Event Player.Target == True;
		Event Player.Power == Custom String("해킹");
	}

	action
	{
		If(Event Player.Ability_target.Role == Custom String("마피아"));
			Modify Global Variable(Mafia_team, Append To Array, Event Player);
			Abort;
		End;
		If(Event Player.Target.Dead);
			Global.Message_request[Count Of(Global.Message_request)] = Array(2, Array Contains(Global.Mafia_team, Event Player)
				&& Array Contains(Global.TF_team, Event Player) ? Append To Array(Global.Mafia_team, First Of(Global.TF_team)) : (
				Array Contains(Global.Mafia_team, Event Player) ? Global.Mafia_team : (Array Contains(Global.TF_team, Event Player)
				? Append To Array(Event Player, First Of(Global.TF_team)) : Event Player)), Hero Icon String(Event Player.Role_icon),
				Custom String("[{0}]님은 이미 죽었습니다", Event Player.Target.Name_plate));
		Else;
			Global.Message_request[Count Of(Global.Message_request)] = Array(2, Array Contains(Global.Mafia_team, Event Player)
				&& Array Contains(Global.TF_team, Event Player) ? Append To Array(Global.Mafia_team, First Of(Global.TF_team)) : (
				Array Contains(Global.Mafia_team, Event Player) ? Global.Mafia_team : (Array Contains(Global.TF_team, Event Player)
				? Append To Array(Event Player, First Of(Global.TF_team)) : Event Player)), Hero Icon String(Event Player.Role_icon),
				Custom String("[{0}]님은 [{1}]입니다", Event Player.Target.Name_plate, Event Player.Target.Role));
		End;
	}
}

rule("마피아 특직 픽")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Jump)) == True;
		Global.Game_mode != Custom String("클래식");
		Event Player.Ability == True;
		Event Player.Power_type != 5;
		Event Player.Power_able_targets > 20;
	}

	action
	{
		Event Player.Ability -= 1;
		Event Player.Target = Event Player.Ability_list[Event Player.Pick_number];
		Call Subroutine(Get_ability_target);
		Event Player.Sound_effect = 1;
		Abort If(!Event Player.Ability_target);
		If(Event Player.Ability_target.Role == Custom String("마피아"));
			Modify Global Variable(Mafia_team, Append To Array, Event Player);
			Wait(1, Ignore Condition);
			Event Player.Ability_for_voting = Event Player.Head;
			Abort;
		End;
		Skip If(!Array Contains(Array(3, 4), Event Player.Power_type), 1);
		Modify Player Variable(Event Player.Ability_target, Condition, Append To Array, Event Player.Power);
		Skip If(!Array Contains(Array(2, 4), Event Player.Power_type), 1);
		Event Player.Power_able_left -= 1;
		Global.Message_request[Count Of(Global.Message_request)] = Array(2, Array Contains(Global.Mafia_team, Event Player)
			&& Array Contains(Global.TF_team, Event Player) ? Append To Array(Global.Mafia_team, First Of(Global.TF_team)) : (
			Array Contains(Global.Mafia_team, Event Player) ? Global.Mafia_team : (Array Contains(Global.TF_team, Event Player)
			? Append To Array(Event Player, First Of(Global.TF_team)) : Event Player)), Hero Icon String(Event Player.Role_icon),
			Custom String("[{0}]님에게 [{1}](을)를 사용하였습니다", Event Player.Target.Name_plate, Event Player.Power));
		Wait(1, Ignore Condition);
		Event Player.Ability_for_voting = Event Player.Head;
	}
}

rule("[서브 루틴] 유령 제거")
{
	event
	{
		Subroutine;
		Destroy_soul;
	}

	action
	{
		Set Invisible(Event Player, None);
		Destroy Effect(Event Player.Soul[2]);
		Destroy Effect(Event Player.Soul[1]);
		Destroy Effect(Event Player.Soul[0]);
		Event Player.Soul = Array(Null, Null, Null);
	}
}

rule("건달 - 협박")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Time == 5;
		Array Contains(Event Player.Condition, Custom String("협박")) == True;
	}

	action
	{
		Skip If(Event Player.Role == Custom String("기계 인간"), 2);
		Event Player.Head -= 1;
	}
}

rule("건달 - 협박 복구")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		(Global.Time == 12 || Global.Time == 1) == True;
		Array Contains(Event Player.Condition, Custom String("협박")) == True;
	}

	action
	{
		Skip If(Event Player.Role == Custom String("기계 인간"), 1);
		Event Player.Head += 1;
		Modify Player Variable(Event Player.Event_player, Condition, Remove From Array By Value, Custom String("협박"));
	}
}

rule("투표 갯수 띄우기")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.Joined == True;
		(Global.Time == 8 || Global.Time == 12 || Global.Time == 1) == True;
	}

	action
	{
		If(Global.Time == 12 || Global.Time == 1);
			Abort If(Event Player.Vote_world_text_ID == Null);
			Destroy In-World Text(Event Player.Vote_world_text_ID);
			Event Player.Vote_world_text_ID = Null;
		Else If(Global.Time == 8);
			Abort If(Event Player.Dead);
			Create In-World Text(Filtered Array(All Players(All Teams), Global.Time_for_night_morning_else == 3 && Global.Squence < 3),
				Custom String("[{0}]표\r\n", Count Of(Event Player.Votes)), Event Player, 1.200, Clip Against Surfaces,
				Visible To Position and String, Color(Orange), Default Visibility);
			Event Player.Vote_world_text_ID = Last Text ID;
		End;
	}
}

rule("투표 결과때 변수 정리")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Time == 12;
		Event Player.Joined == True;
	}

	action
	{
		Event Player.P_Yes_or_no = Null;
	}
}

rule("투표 시간 단축")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Is True For All(Global.Live_players, Current Array Element.Done_voting == True) == True;
		Global.Time == 8;
		Match Time > 3;
	}

	action
	{
		Global.Message_request[Count Of(Global.Message_request)] = Array(1, Global.Players, Null, Custom String(
			"모두 투표를 완료하여 시간이 단축됩니다\r\n"));
		Set Match Time(3);
	}
}

rule("직업 표시")
{
	event
	{
		Subroutine;
		Role_guide;
	}

	action
	{
		Skip If(Event Player.Role_guide_text_ID == Null, 2);
		Destroy HUD Text(Event Player.Role_guide_text_ID);
		Event Player.Role_guide_text_ID = Null;
		Create HUD Text(Event Player, Hero Icon String(Event Player.Role_icon), Null, Custom String("[{0}]\r\n당신은 [{1}]입니다\r\n{2}",
			Event Player.Name_plate, Event Player.Role, Custom String("{0} 직업 설명 {1}", Input Binding String(Button(Reload)),
			Event Player.Guide ? Custom String("닫기\r\n\r\n{0} 팀입니다\r\n\r\n{1}", Event Player.Team_color == 1 ? Custom String("시민") : (
			Event Player.Team_color == 2 ? Custom String("마피아") : (Event Player.Team_color == 3 ? Custom String("3 세력") : 0)),
			Event Player.Role_guide) : Custom String("열기"))), Right, 1, Event Player.Team_color == 1 ? Color(Sky Blue) : (
			Event Player.Team_color == 2 ? Color(Red) : (Event Player.Team_color == 3 ? Color(Purple) : 0)), Color(흰색), Color(흰색),
			Visible To Sort Order String and Color, Default Visibility);
		Event Player.Role_guide_text_ID = Last Text ID;
	}
}

rule("강제픽")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Match Time < 1;
		Match Time != 0;
		Global.Time == 2;
		Event Player.Dead == False;
		Event Player.Target == False;
		Event Player.Power_able_targets > 10;
		Event Player.Power_able_targets < 20;
	}

	action
	{
		Event Player.Ability -= 1;
		Event Player.Target = Random Value In Array(Event Player.Ability_list);
		Call Subroutine(Get_ability_target);
		Event Player.Sound_effect = 1;
		Abort If(!Event Player.Ability_target);
		Skip If(!Array Contains(Array(3, 4), Event Player.Power_type), 1);
		Event Player.Ability_target.Condition[Count Of(Event Player.Ability_target.Condition)] = Array(Event Player.Power, Event Player);
		Skip If(!Array Contains(Array(2, 4), Event Player.Power_type), 1);
		Event Player.Power_able_left -= 1;
		If(Array Contains(Event Player.Condition, Custom String("포교")));
			Global.Message_request[Count Of(Global.Message_request)] = Array(2, Filtered Array(Global.Players,
				Current Array Element.Role == Custom String("사이비 교주")), Hero Icon String(Event Player.Role_icon), Custom String(
				"[{0}]님이 [{1}]님을 지목하였습니다", Event Player.Name_plate, Event Player.Target.Name_plate));
		End;
	}
}

rule("타이머 넣기")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global.Time_for_timer == True;
		Match Time == True;
	}

	action
	{
		Global.UI_color = Match Time;
	}
}

rule("히트 캐스트가 아님")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Squence == 2;
		Global.Game_mode != Custom String("클래식");
		Event Player.Role != Custom String("마피아");
		Event Player.Role != Custom String("짐승 인간");
		Event Player.Power_able_targets == True;
	}

	action
	{
		Create HUD Text(Filtered Array(Event Player, Event Player.Ability && Event Player.Ability_UI == 2), First Of(
			Event Player.Ability_list)
			!= False || Event Player.Pick_number ? Event Player.Ability_list[Event Player.Pick_number].Name_plate : Custom String("선택 안함"),
			Null, Null, Top, -5, Color(Red), Color(흰색), Color(흰색), Visible To and String, Default Visibility);
	}
}

rule("능력 UI 변경")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.Ability == True;
	}

	action
	{
		If(Global.Game_mode == Custom String("클래식") || Event Player.Power_type == 5);
			Event Player.Ability_UI = 1;
		Else;
			Event Player.Ability_UI = 2;
		End;
	}
}

rule("타임머신을 발굴한 도굴꾼 설정")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.Role == Custom String("타임머신을 발굴한 도굴꾼");
	}

	action
	{
		Event Player.Power = Custom String("타임머신");
		Event Player.Power_able_day = Random Integer(2, 8);
		Event Player.Role_guide = Custom String("[타임머신]\r\n타임머신을 주었습니다\r\n뭐에 쓰는 물건일까요?\r\n\r\n하단에 숫자 {0}이 적혀있습니다",
			Event Player.Power_able_day);
	}
}

rule("타임머신 발동")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Day >= Event Player.Power_able_day;
		Event Player.Power_able_day == True;
		Global.Time == 5;
		Event Player.Role == Custom String("타임머신을 발굴한 도굴꾼");
		Event Player.Dead == False;
	}

	action
	{
		Global.Time_muchine = True;
		Wait Until(Global.Time == 6, 99999);
		Wait(3, Ignore Condition);
		Set Match Time(Random Integer(30, 180));
		Big Message(All Players(All Teams), Custom String("무언가 이상합니다.."));
		Wait(3, Ignore Condition);
		Set Match Time(Random Integer(30, 180));
		Global.Players.Role = Custom String("시공간 방황자");
		Create Effect(All Players(All Teams), Bad Aura, Custom Color(0, 77, 190, 255), Global.Map_point + Up,
			1 + 0.400 * Sine From Radians(Total Time Elapsed * 3), Visible To Position and Radius);
		Global.Effect_ID = Last Created Entity;
		Create Effect(All Players(All Teams), Energy Sound, Color(흰색), Global.Map_point, 40, Visible To Position and Radius);
		Global.Sound_effect_ID = Last Created Entity;
		Big Message(All Players(All Teams), Custom String("시공간이 뒤틀립니다"));
		Wait(3, Ignore Condition);
		While(Global.Dead_players);
			Set Match Time(Random Integer(30, 180));
			Last Of(Global.Dead_players).Dead = Null;
			Wait(1, Ignore Condition);
		End;
		For Global Variable(For_Division_roles, 0, Count Of(Global.Roles), 1);
			Global.Players[Global.For_Division_roles].Role = Global.Roles[Global.For_Division_roles];
		End;
		Wait(3, Ignore Condition);
		Set Match Time(Random Integer(30, 180));
		Destroy Effect(Global.Sound_effect_ID);
		Play Effect(All Players(All Teams), Ring Explosion, Custom Color(0, 77, 191, 255), Global.Map_point, 20);
		Play Effect(All Players(All Teams), Explosion Sound, Color(Blue), Global.Map_point, 60);
		Destroy Effect(Global.Effect_ID);
		Wait(1, Ignore Condition);
		Global.Day = 0;
		Global.Time = 1;
		Global.Time_for_timer = Null;
		Global.Time_muchine = Null;
	}
}

rule("시공간 방황자 설정")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.Role == Custom String("시공간 방황자");
	}

	action
	{
		Event Player.Power = Custom String("발버둥");
		Event Player.Role_guide = Custom String("[발버둥]\r\n소용돌이에 빨려 들어가지 않게 발버둥을 칩니다");
		Event Player.Value_for_ability = Null;
		Event Player.Array_for_ability = Null;
		Event Player.Ability_list = Null;
		Event Player.Target = Null;
		Event Player.Condition = Empty Array;
		Event Player.Ability_black_list = Empty Array;
		Event Player.Ability_black_list = Empty Array;
		Event Player.Head = 1;
	}
}

rule("스토커 UI")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Array Contains(Global.Roles, Custom String("스토커")) == True;
	}

	action
	{
		Create HUD Text(Filtered Array(Global.Players, Current Array Element.Role == Custom String("스토커")), Null, Null, Custom String(
			"\r\n대상\r\n"), Right, 2, Color(흰색), Color(흰색), Color(흰색), Visible To and String, Default Visibility);
		Create HUD Text(Filtered Array(Global.Players, Current Array Element.Role == Custom String("스토커")), Icon String(Question Mark),
			Custom String("대상의 진영을 추리하세요"), First Of(Global.TF_team).Value_for_ability ? Custom String("[{0}]", First Of(Global.TF_team)
			.Value_for_ability.Name_plate) : Custom String("[아직 대상이 없습니다]"), Right, 3, Color(흰색), Color(흰색), Color(흰색),
			Visible To and String, Default Visibility);
	}
}

rule("스토킹 손보기")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Time == 5;
		Event Player.Target == True;
		Event Player.Power == Custom String("스토킹");
	}

	action
	{
		If(Event Player.Target.Dead);
			Global.Message_request[Count Of(Global.Message_request)] = Array(3, Event Player, Hero Icon String(Event Player.Role_icon),
				Custom String("[{0}]님은 이미 죽었습니다", Event Player.Target.Name_plate));
		Else If(Event Player.Ability_target.Target);
			Global.Message_request[Count Of(Global.Message_request)] = Array(3, Event Player, Hero Icon String(Event Player.Role_icon),
				Custom String("[{0}] ☞ [{1}]", Event Player.Target.Name_plate, Event Player.Ability_target.Target.Name_plate));
		Else;
			Global.Message_request[Count Of(Global.Message_request)] = Array(3, Event Player, Hero Icon String(Event Player.Role_icon),
				Custom String("[{0}] ☞ Ⅹ", Event Player.Target.Name_plate));
		End;
	}
}
