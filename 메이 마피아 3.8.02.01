rule("카메라 사용 온")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.Camera_type == True;
	}

	action
	{
		Stop Camera(Event Player);
		Wait(0.250, Ignore Condition);
		"밤 카메라"
		If(Event Player.Camera_type == 1);
			Start Camera(Event Player, Global.Location[0], Global.Location[1], 0);
			Event Player.Sound_position = Global.Location[0];
		"특정 인물 카메라"
		Else If(Event Player.Camera_type == 2);
			Global.Camera_eye_position = Global.Camera_look_at_position.Player_position + Up * 1.500 + Direction Towards(
				Global.Camera_look_at_position, Global.Map_point) * 2.500;
			Start Camera(Global.Players, Global.Camera_eye_position, Position Of(Global.Camera_look_at_position) + Up, 0);
			Event Player.Sound_position = Global.Camera_eye_position;
		"인트로"
		Else If(Event Player.Camera_type == 3);
			Start Camera(Event Player, Ray Cast Hit Position(Global.Map_point + Vector(0, 2, 0), Global.Map_point + Vector(0, 2, 0)
				+ 7 * Direction From Angles(5 * Total Time Elapsed, 3 * Sine From Degrees(20 * Total Time Elapsed) - 5), Empty Array,
				Empty Array, False), Global.Map_point + Up * 2, 15);
		"승패 카메라"
		Else If(Event Player.Camera_type == 4);
			Start Camera(Event Player, Global.Location[6], Global.Location[4], 0);
		End;
		Event Player.Camera_type = Null;
		Event Player.Using_camera = True;
	}
}

rule("카메라 사용 오프")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.Using_camera == False;
		Global.Squence == True;
		Event Player.Joined == True;
	}

	action
	{
		Stop Camera(Event Player);
		Wait(0.250, Ignore Condition);
		If(Event Player.Dead || Event Player.Third_person_look);
			Start Camera(Event Player, Ray Cast Hit Position(Eye Position(Event Player), Eye Position(Event Player) + Facing Direction Of(
				Event Player) * -2 + Up, All Players(All Teams), Event Player, True), Eye Position(Event Player) + Facing Direction Of(
				Event Player) * 10, 15);
		End;
		Event Player.Sound_position = Position Of(Event Player);
	}
}

rule("클래식 모드 카메라 온 오프")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Game_mode == Custom String("클래식");
		Event Player.Value_for_ability == True;
	}

	action
	{
		If(Event Player.Using_camera);
			Event Player.Using_camera = False;
			Stop Facing(Event Player);
			Skip If(Event Player.Dead, 1);
			Event Player.Ability = 1;
		Else;
			Event Player.Camera_type = 1;
			Start Facing(Event Player, Direction From Angles(Horizontal Angle From Direction(Direction Towards(Event Player,
				Global.Map_point)), 85), 150, To World, Direction and Turn Rate);
			Event Player.Ability = Null;
		End;
		Event Player.Value_for_ability = !Event Player.Value_for_ability;
	}
}

rule("카메라 사용 중 감정 표현 금지")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Communicating Any Emote(Event Player) == True;
		Global.Squence == 2;
		Event Player.Using_camera == True;
	}

	action
	{
		Cancel Primary Action(Event Player);
	}
}

rule("메시지 띄우기")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global.Message_request == True;
		Global.Squence == 2;
	}

	action
	{
		Call Subroutine(Message);
		Modify Global Variable(Message_request, Remove From Array By Index, 0);
		Wait(0.100, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("[서브 루틴] 메시지 띄우기")
{
	event
	{
		Subroutine;
		Message;
	}

	action
	{
		If(First Of(Global.Message_request)[2]);
			If(First Of(Global.Message_request)[0] == 1);
				Create HUD Text(First Of(Global.Message_request)[1], Null, Custom String("　　 [전체]"), Custom String("{0} {1}\r\n", First Of(
					Global.Message_request)[2], First Of(Global.Message_request)[3]), Top, Global.Message_sorted_number, Color(흰색), Color(Orange),
					Color(흰색), None, Default Visibility);
			Else If(First Of(Global.Message_request)[0] == 2);
				Create HUD Text(First Of(Global.Message_request)[1], Null, Custom String("　　 [팀]"), Custom String("{0} {1}\r\n", First Of(
					Global.Message_request)[2], First Of(Global.Message_request)[3]), Top, Global.Message_sorted_number, Color(흰색), Color(
					Lime Green), Color(흰색), None, Default Visibility);
			Else;
				Create HUD Text(First Of(Global.Message_request)[1], Null, Custom String("　　 [개인]"), Custom String("{0} {1}\r\n", First Of(
					Global.Message_request)[2], First Of(Global.Message_request)[3]), Top, Global.Message_sorted_number, Color(Aqua), Color(
					Lime Green), Color(흰색), None, Default Visibility);
			End;
		Else;
			Create HUD Text(First Of(Global.Message_request)[1], Null, Null, First Of(Global.Message_request)[3], Top,
				Global.Message_sorted_number, Color(흰색), Color(흰색), Color(흰색), None, Default Visibility);
		End;
		Modify Global Variable(Message_text_ID, Append To Array, Last Text ID);
		Modify Global Variable(Message_time, Append To Array, Total Time Elapsed + Global.Message_left_time);
	}
}

rule("메시지 지우기")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global.Message_text_ID == True;
		First Of(Global.Message_time) <= Total Time Elapsed;
	}

	action
	{
		Destroy HUD Text(First Of(Global.Message_text_ID));
		Modify Global Variable(Message_text_ID, Remove From Array By Index, 0);
		Modify Global Variable(Message_time, Remove From Array By Index, 0);
		Wait(0.100, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("리퀘스트 메시지 띄우기")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Time == 5;
		Event Player.P_Message_request == True;
	}

	action
	{
		Global.Message_request[Count Of(Global.Message_request)] = First Of(Event Player.P_Message_request);
		Modify Player Variable(Event Player, P_Message_request, Remove From Array By Index, 0);
		Wait(0.100, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("투표 알림")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Count Of(Event Player.Votes) > Event Player.Votes_counter;
	}

	action
	{
		Skip If(Event Player.Votes_message_text_ID == Null, 2);
		Destroy HUD Text(Event Player.Votes_message_text_ID);
		Event Player.Votes_message_text_ID = Null;
		Create HUD Text(All Players(All Teams), Null, Null, Custom String("[{0}]님이 총 [{1}]표를 받았습니다\r\n", Event Player.Name_plate, Count Of(
			Event Player.Votes)), Top, Global.Message_sorted_number, Color(흰색), Color(흰색), Color(흰색), None, Default Visibility);
		Event Player.Votes_message_text_ID = Last Text ID;
		Event Player.Votes_counter = Count Of(Event Player.Votes);
		Wait(Global.Message_left_time, Restart When True);
		Destroy HUD Text(Event Player.Votes_message_text_ID);
		Event Player.Votes_message_text_ID = Null;
	}
}

rule("가이드 열고 닫기")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Reload)) == True;
		Global.Squence >= 2;
		Event Player.Joined == True;
	}

	action
	{
		Event Player.Guide = !Event Player.Guide;
	}
}

rule("60초 마다 팁 뽑기")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Squence == 2;
		Event Player.Joined == True;
	}

	action
	{
		Wait(60, Ignore Condition);
		If(Event Player.Dead);
			Event Player.Ghost_tip = Random Value In Array(Global.Ghost_tips);
		Else;
			Event Player.Tip_or_joke = Random Value In Array(Event Player.Tips_and_jokes);
		End;
		Loop If Condition Is True;
	}
}

rule("이동 불가")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Squence >= 2;
		Event Player.Joined == True;
		Distance Between(Vector(X Component Of(Position Of(Event Player)), 0, Z Component Of(Position Of(Event Player))), Vector(
			X Component Of(Event Player.Player_position), 0, Z Component Of(Event Player.Player_position))) >= 0.200;
	}

	action
	{
		Teleport(Event Player, Event Player.Player_position);
		Wait(0.500, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("[서브 루틴] 플레이어 네임플랫")
{
	event
	{
		Subroutine;
		Name_plate;
	}

	action
	{
		Skip If(Event Player.Name_plate_text_ID == Null, 1);
		Destroy In-World Text(Event Player.Name_plate_text_ID);
		If(Global.Squence >= 3);
			Create In-World Text(All Players(All Teams), Custom String(" \r\n{0}", Event Player.Name_plate), Event Player, 1.200,
				Clip Against Surfaces, Visible To and Position, Color(흰색), Default Visibility);
		Else;
			If(Event Player.Dead);
				Create In-World Text(All Players(All Teams), Custom String(" \r\n{0}", Event Player.Name_plate),
					Event Player.Player_position + Up * 1.500, 1.200, Clip Against Surfaces, Visible To and Position, Color(흰색),
					Default Visibility);
			Else;
				Create In-World Text(All Players(All Teams), Custom String(" \r\n{0}", Event Player.Name_plate), Event Player, 1.200,
					Clip Against Surfaces, Visible To and Position, Color(흰색), Default Visibility);
			End;
		End;
		Event Player.Name_plate_text_ID = Last Text ID;
	}
}

rule("죽을때 임팩트")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Filtered Array(Global.Players, Is Dead(Current Array Element)) == True;
	}

	action
	{
		Set Slow Motion(20);
		Wait(0.500, Ignore Condition);
		Set Slow Motion(100);
		Wait(5, Ignore Condition);
	}
}

rule("플레이어 죽음")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.Dead == True;
		Global.Squence == 2;
	}

	action
	{
		Kill(Event Player, Null);
		Wait(1, Ignore Condition);
		Skip If(Global.Squence >= 3, 2);
		Modify Global Variable(Live_players, Remove From Array By Value, Event Player);
		Modify Global Variable(Dead_players, Append To Array, Event Player);
		Call Subroutine(Create_soul);
		Call Subroutine(Name_plate);
		Create Icon(All Players(All Teams), Event Player.Player_position + Up * 1.600, Skull, Visible To and Position,
			Event Player.Dead == 1 ? Color(Orange) : Color(Purple), False);
		Event Player.Dead_Icon = Last Created Entity;
		Disallow Button(Event Player, Button(Melee));
	}
}

rule("[서브 루틴] 유령 생성")
{
	event
	{
		Subroutine;
		Create_soul;
	}

	action
	{
		Set Invisible(Event Player, All);
		If(Event Player.Soul);
			Destroy Effect(Event Player.Soul[2]);
			Destroy Effect(Event Player.Soul[1]);
			Destroy Effect(Event Player.Soul[0]);
			Event Player.Soul = Array(Null, Null, Null);
		End;
		If(Global.Squence >= 3);
			Create Effect(All Players(All Teams), Cloud, Color(Sky Blue), Eye Position(Event Player), 0.050, Visible To Position and Radius);
			Event Player.Soul[0] = Last Created Entity;
			Create Effect(All Players(All Teams), Sphere, Color(흰색), Eye Position(Event Player) + World Vector Of(Vector(0.120, 0, -0.300),
				Event Player, Rotation) + Direction From Angles(Horizontal Facing Angle Of(Event Player), Vertical Facing Angle Of(
				Event Player) + 8) * 0.500, 0.050, Visible To Position and Radius);
			Event Player.Soul[1] = Last Created Entity;
			Create Effect(All Players(All Teams), Sphere, Color(흰색), Eye Position(Event Player) + World Vector Of(Vector(-0.120, 0, -0.300),
				Event Player, Rotation) + Direction From Angles(Horizontal Facing Angle Of(Event Player), Vertical Facing Angle Of(
				Event Player) + 8) * 0.500, 0.050, Visible To Position and Radius);
			Event Player.Soul[2] = Last Created Entity;
		Else;
			Create Effect(Append To Array(Global.Dead_players, Filtered Array(Global.Live_players,
				Current Array Element.Power == Custom String("성불"))), Cloud, Color(Sky Blue), Eye Position(Event Player), 0.050,
				Visible To Position and Radius);
			Event Player.Soul[0] = Last Created Entity;
			Create Effect(Append To Array(Global.Dead_players, Filtered Array(Global.Live_players,
				Current Array Element.Power == Custom String("성불"))), Sphere, Color(흰색), Eye Position(Event Player) + World Vector Of(Vector(
				0.120, 0, -0.300), Event Player, Rotation) + Direction From Angles(Horizontal Facing Angle Of(Event Player),
				Vertical Facing Angle Of(Event Player) + 8) * 0.500, 0.050, Visible To Position and Radius);
			Event Player.Soul[1] = Last Created Entity;
			Create Effect(Append To Array(Global.Dead_players, Filtered Array(Global.Live_players,
				Current Array Element.Power == Custom String("성불"))), Sphere, Color(흰색), Eye Position(Event Player) + World Vector Of(Vector(
				-0.120, 0, -0.300), Event Player, Rotation) + Direction From Angles(Horizontal Facing Angle Of(Event Player),
				Vertical Facing Angle Of(Event Player) + 8) * 0.500, 0.050, Visible To Position and Radius);
			Event Player.Soul[2] = Last Created Entity;
		End;
	}
}

rule("죽은 뒤 소통")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		(Is Button Held(Event Player, Button(Primary Fire)) || Is Button Held(Event Player, Button(Ultimate)) || Is Button Held(
			Event Player, Button(Ability 2))) == True;
		Global.Time == 6;
		Event Player.Dead == True;
		Array Contains(Event Player.Condition, Custom String("성불")) == False;
	}

	action
	{
		Skip If(Event Player.Dead_talk == Null, 1);
		Destroy In-World Text(Event Player.Dead_talk);
		Event Player.Dead_talk = Null;
		If(Is Button Held(Event Player, Button(Primary Fire)));
			Event Player.Hit_scan_player = Ray Cast Hit Player(Eye Position(Event Player), Eye Position(Event Player) + Facing Direction Of(
				Event Player) * 10, All Players(All Teams), Event Player, True);
			Abort If(!Event Player.Hit_scan_player);
			Create In-World Text(Append To Array(Global.Dead_players, Filtered Array(Global.Live_players,
				Current Array Element.Power == Custom String("성불"))), Custom String("[{0}]님을 노려봅니다\r\n ",
				Event Player.Hit_scan_player.Name_plate), Event Player.Player_position + Up * 1.500, 1.300, Do Not Clip,
				Visible To and Position, Color(Blue), Default Visibility);
		Else If(Is Button Held(Event Player, Button(Ultimate)));
			Create In-World Text(Append To Array(Global.Dead_players, Filtered Array(Global.Live_players,
				Current Array Element.Power == Custom String("성불"))), Custom String("절레 절레\r\n "), Event Player.Player_position + Up * 1.500,
				1.500, Do Not Clip, Visible To and Position, Color(Blue), Default Visibility);
		Else If(Is Button Held(Event Player, Button(Ability 2)));
			Create In-World Text(Append To Array(Global.Dead_players, Filtered Array(Global.Live_players,
				Current Array Element.Power == Custom String("성불"))), Custom String("끄덕 끄덕\r\n "), Event Player.Player_position + Up * 1.500,
				1.500, Do Not Clip, Visible To and Position, Color(Blue), Default Visibility);
		End;
		Event Player.Dead_talk = Last Text ID;
		Wait(3, Restart When True);
		Destroy In-World Text(Event Player.Dead_talk);
		Event Player.Dead_talk = Null;
	}
}

rule("플레이어 부활")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.Dead == False;
		Global.Squence == 2;
		Array Contains(Global.Dead_players, Event Player) == True;
	}

	action
	{
		Play Effect(All Players(All Teams), Good Pickup Effect, Color(Yellow), Event Player, 1);
		Global.Players.Sound_effect = 1;
		Skip If(Global.Squence >= 3, 2);
		Modify Global Variable(Dead_players, Remove From Array By Value, Event Player);
		Modify Global Variable(Live_players, Append To Array, Event Player);
		Call Subroutine(Destroy_soul);
		Call Subroutine(Name_plate);
		Destroy Icon(Event Player.Dead_Icon);
		Allow Button(Event Player, Button(Melee));
	}
}

rule("마피아 팀 합류")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Count Of(Global.Mafia_team) >= 2;
		Global.Squence == 2;
		Array Contains(Global.Mafia_team, Event Player) == True;
	}

	action
	{
		Modify Global Variable(Citizen_team, Remove From Array By Value, Event Player);
		Create HUD Text(Remove From Array(Global.Mafia_team, Event Player), Hero Icon String(Event Player.Role_icon), Null, Custom String(
			"[{0}]\r\n{1}", Event Player.Role, Event Player.Name_plate), Right, 3, Color(Red), Color(흰색), Color(흰색), Visible To and String,
			Default Visibility);
		Start Forcing Player Outlines(Event Player, Global.Mafia_team, True, Color(Red), Default);
		Start Forcing Player Outlines(Global.Mafia_team, Event Player, True, Color(Red), Default);
		Abort If(Event Player.Class == 4);
		Global.Message_request[Count Of(Global.Message_request)] = Array(2, Append To Array(Filtered Array(Array(Global.Mafia_team,
			Global.TF_team), Array Contains(Current Array Element, Event Player)), Event Player), Hero Icon String(Event Player.Role_icon),
			Custom String("[{0}]님이 접선하였습니다", Event Player.Name_plate));
	}
}

rule("3 세력 합류")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Count Of(Global.TF_team) >= 2;
		Global.Squence == 2;
		Array Contains(Global.TF_team, Event Player) == True;
	}

	action
	{
		Modify Global Variable(Citizen_team, Remove From Array By Value, Event Player);
		Event Player.Team = 6;
		Event Player.Team_color = 3;
		Call Subroutine(Role_guide);
		If(Array Contains(Event Player.Condition, Custom String("포교")));
			Create HUD Text(Filtered Array(Global.Players, Current Array Element.Role == Custom String("사이비 교주")), Hero Icon String(
				Event Player.Role_icon), Null, Custom String("[{0}]\r\n{1}", Event Player.Role, Event Player.Name_plate), Right, 3, Color(
				Purple), Color(흰색), Color(흰색), Visible To and String, Default Visibility);
			Start Forcing Player Outlines(Event Player, Filtered Array(Global.Players, Current Array Element.Role == Custom String("사이비 교주")),
				True, Color(Purple), Default);
			Start Forcing Player Outlines(Filtered Array(Global.Players, Current Array Element.Role == Custom String("사이비 교주")), Event Player,
				True, Color(Purple), Default);
		Else;
			Create HUD Text(Remove From Array(Global.TF_team, Event Player), Hero Icon String(Event Player.Role_icon), Null, Custom String(
				"[{0}]\r\n{1}", Event Player.Role, Event Player.Name_plate), Right, 3, Color(Purple), Color(흰색), Color(흰색),
				Visible To and String, Default Visibility);
			Start Forcing Player Outlines(Event Player, Global.TF_team, True, Color(Purple), Default);
			Start Forcing Player Outlines(Global.TF_team, Event Player, True, Color(Purple), Default);
		End;
	}
}

rule("선택지 - 밤")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Time == 1;
		Event Player.Power_able_left == True;
		Event Player.Power_able_targets == True;
		Event Player.Power_able_targets < 20;
		Event Player.Dead == False;
	}

	action
	{
		Event Player.Pick_number = Null;
		If(Event Player.Role == Custom String("도둑"));
			If(Event Player.Power_able_targets == 1);
				Event Player.Ability_list = Append To Array(False, Global.Live_players);
			Else If(Event Player.Power_able_targets == 2);
				Event Player.Ability_list = Append To Array(False, Remove From Array(Global.Live_players, Event Player));
			Else If(Event Player.Power_able_targets == 3);
				Event Player.Ability_list = Append To Array(False, Filtered Array(Global.Dead_players, !Array Contains(
					Current Array Element.Condition, Custom String("성불"))));
			Else If(Event Player.Power_able_targets == 11);
				Event Player.Ability_list = Global.Live_players;
			Else If(Event Player.Power_able_targets == 12);
				Event Player.Ability_list = Remove From Array(Global.Live_players, Event Player);
			Else If(Event Player.Power_able_targets == 13);
				Event Player.Ability_list = Filtered Array(Global.Dead_players, !Array Contains(Current Array Element.Condition, Custom String(
					"성불")));
			End;
		Else If(Event Player.Power_able_targets == 1);
			Event Player.Ability_list = Append To Array(False, Remove From Array(Global.Live_players, Event Player.Ability_black_list));
		Else If(Event Player.Power_able_targets == 2);
			Event Player.Ability_list = Append To Array(False, Remove From Array(Remove From Array(Global.Live_players, Event Player),
				Event Player.Ability_black_list));
		Else If(Event Player.Power_able_targets == 3);
			Event Player.Ability_list = Append To Array(False, Remove From Array(Filtered Array(Global.Dead_players, !Array Contains(
				Current Array Element.Condition, Custom String("성불"))), Event Player.Ability_black_list));
		Else If(Event Player.Power_able_targets == 11);
			Event Player.Ability_list = Remove From Array(Global.Live_players, Event Player.Ability_black_list);
		Else If(Event Player.Power_able_targets == 12);
			Event Player.Ability_list = Remove From Array(Remove From Array(Global.Live_players, Event Player),
				Event Player.Ability_black_list);
		Else If(Event Player.Power_able_targets == 13);
			Event Player.Ability_list = Remove From Array(Filtered Array(Global.Dead_players, !Array Contains(Current Array Element.Condition,
				Custom String("성불"))), Event Player.Ability_black_list);
		End;
	}
}

rule("선택지 - 투표 시간")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Time == 7;
		Event Player.Power_able_left == True;
		Event Player.Power_able_targets == True;
		Event Player.Power_able_targets > 20;
		Event Player.Dead == False;
	}

	action
	{
		Event Player.Pick_number = Null;
		If(Event Player.Power_able_targets == 21);
			Event Player.Ability_list = Append To Array(False, Remove From Array(Global.Live_players, Event Player.Ability_black_list));
		Else If(Event Player.Power_able_targets == 22);
			Event Player.Ability_list = Append To Array(False, Remove From Array(Remove From Array(Global.Live_players, Event Player),
				Event Player.Ability_black_list));
		Else If(Event Player.Power_able_targets == 23);
			Event Player.Ability_list = Append To Array(False, Remove From Array(Filtered Array(Global.Dead_players, !Array Contains(
				Current Array Element.Condition, Custom String("성불"))), Event Player.Ability_black_list));
		Else If(Event Player.Power_able_targets == 31);
			Event Player.Ability_list = Remove From Array(Global.Live_players, Event Player.Ability_black_list);
		Else If(Event Player.Power_able_targets == 32);
			Event Player.Ability_list = Remove From Array(Remove From Array(Global.Live_players, Event Player),
				Event Player.Ability_black_list);
		Else If(Event Player.Power_able_targets == 33);
			Event Player.Ability_list = Remove From Array(Filtered Array(Global.Dead_players, !Array Contains(Current Array Element.Condition,
				Custom String("성불"))), Event Player.Ability_black_list);
		End;
	}
}

rule("히트 스캔 이펙트")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Squence == 2;
		disabled Global.Game_mode == Custom String("클래식");
		Event Player.Joined == True;
	}

	action
	{
		Create In-World Text(Filtered Array(Event Player, Ray Cast Hit Player(Eye Position(Event Player), Eye Position(Event Player)
			+ Facing Direction Of(Event Player) * 10, Global.Live_players, Event Player, True) == True && (
			Event Player.Ability_for_voting || (Event Player.Ability && Event Player.Ability_UI == 1))), Custom String("{0} 선택하기",
			Input Binding String(Button(Primary Fire))), Position Of(Player Closest To Reticle(Event Player, All Teams)) + Up * 0.500,
			1.500, Do Not Clip, Visible To Position and String, Color(흰색), Default Visibility);
		Create Effect(Filtered Array(Event Player, Ray Cast Hit Player(Eye Position(Event Player), Eye Position(Event Player)
			+ Facing Direction Of(Event Player) * 10, Global.Live_players, Event Player, True) == True && (
			Event Player.Ability_for_voting || (Event Player.Ability && Event Player.Ability_UI == 1))), Ring, Color(Red),
			Nearest Walkable Position(Player Closest To Reticle(Event Player, All Teams)), 0.800 + 0.200 * Sine From Radians(
			Total Time Elapsed * 1.500), Visible To Position and Radius);
	}
}

rule("픽 올리고 내리기")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		(Is Button Held(Event Player, Button(Primary Fire)) || Is Button Held(Event Player, Button(Secondary Fire))) == True;
		Global.Game_mode != Custom String("클래식");
		Event Player.Ability == True;
	}

	action
	{
		If(Is Button Held(Event Player, Button(Secondary Fire)));
			If(Event Player.Pick_number >= Count Of(Event Player.Ability_list) - 1);
				Event Player.Pick_number = Null;
			Else;
				Event Player.Pick_number += 1;
			End;
		Else If(Is Button Held(Event Player, Button(Primary Fire)));
			If(Event Player.Pick_number <= 0);
				Event Player.Pick_number = Count Of(Event Player.Ability_list) - 1;
			Else;
				Event Player.Pick_number -= 1;
			End;
		End;
		Event Player.Sound_effect = 5;
	}
}

disabled rule("투표 픽 올리고 내리기")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		(Is Button Held(Event Player, Button(Primary Fire)) || Is Button Held(Event Player, Button(Secondary Fire))) == True;
		Global.Game_mode != Custom String("클래식");
		Event Player.Ability_for_voting == True;
	}

	action
	{
		If(Is Button Held(Event Player, Button(Secondary Fire)));
			If(Event Player.Pick_number_for_voting >= Count Of(Global.Voter_list) - 1);
				Event Player.Pick_number_for_voting = Null;
			Else;
				Event Player.Pick_number_for_voting += 1;
			End;
		Else If(Is Button Held(Event Player, Button(Primary Fire)));
			If(Event Player.Pick_number_for_voting <= 0);
				Event Player.Pick_number_for_voting = Count Of(Global.Voter_list) - 1;
			Else;
				Event Player.Pick_number_for_voting -= 1;
			End;
		End;
		Event Player.Sound_effect = 5;
	}
}

rule("픽")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Jump)) == True;
		Global.Game_mode != Custom String("클래식");
		Event Player.Ability == True;
		Event Player.Power_type != 5;
		Event Player.Power_able_targets < 20;
	}

	action
	{
		Event Player.Ability -= 1;
		Event Player.Target = Event Player.Ability_list[Event Player.Pick_number];
		Call Subroutine(Get_ability_target);
		Event Player.Sound_effect = 1;
		Abort If(!Event Player.Ability_target);
		Skip If(!Array Contains(Array(3, 4), Event Player.Power_type), 1);
		Event Player.Ability_target.Condition[Count Of(Event Player.Ability_target.Condition)] = Array(Event Player.Power, Event Player);
		Skip If(!Array Contains(Array(2, 4), Event Player.Power_type), 1);
		Event Player.Power_able_left -= 1;
		If(Array Contains(Event Player.Condition, Custom String("포교")));
			Global.Message_request[Count Of(Global.Message_request)] = Array(2, First Of(Global.TF_team), Hero Icon String(
				Event Player.Role_icon), Custom String("[{0}]님이 [{1}]님을 지목하였습니다", Event Player.Name_plate, Event Player.Target.Name_plate));
		End;
	}
}

rule("픽 - 클래식 모드")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		(Is Button Held(Event Player, Button(Primary Fire)) || Is Button Held(Event Player, Button(Crouch))) == True;
		Is Crouching(Event Player) == False;
		Global.Game_mode == Custom String("클래식");
		Event Player.Ability == True;
		Event Player.Power_type != 5;
	}

	action
	{
		Skip If(!Is Button Held(Event Player, Button(Primary Fire)), 2);
		Event Player.Hit_scan_player = Ray Cast Hit Player(Eye Position(Event Player), Eye Position(Event Player) + Facing Direction Of(
			Event Player) * 10, Global.Live_players, Event Player, True);
		Abort If(!Event Player.Hit_scan_player);
		If(Is Button Held(Event Player, Button(Primary Fire)));
			Event Player.Ability -= 1;
			Event Player.Target = Event Player.Hit_scan_player;
		Else If(Is Button Held(Event Player, Button(Crouch)));
			Event Player.Ability -= 1;
			Event Player.Target = Event Player;
		End;
		Call Subroutine(Get_ability_target);
		Event Player.Sound_effect = 1;
		Abort If(!Event Player.Ability_target);
		Skip If(!Array Contains(Array(3, 4), Event Player.Power_type), 2);
		Event Player.Ability_target.Condition[Count Of(Event Player.Ability_target.Condition)] = Array(Event Player.Power, Event Player);
		Skip If(!Array Contains(Array(2, 4), Event Player.Power_type), 1);
		Event Player.Power_able_left -= 1;
	}
}

disabled rule("마피아 픽")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Jump)) == True;
		Global.Game_mode != Custom String("클래식");
		Event Player.Ability == True;
		Event Player.Power_type == 5;
	}

	action
	{
		Filtered Array(Global.Players, Current Array Element.Power == Event Player.Power).Target = Null;
		Modify Player Variable(Global.Players, Condition, Remove From Array By Value, Event Player.Power);
		Event Player.Target = Event Player.Ability_list[Event Player.Pick_number];
		Call Subroutine(Get_ability_target);
		Global.Mafia_team.Sound_effect = 1;
		Abort If(Event Player.Ability_target == False);
		Event Player.Ability_target.Condition[Count Of(Event Player.Ability_target.Condition)] = Array(Event Player.Power, Event Player);
		Global.Message_request[Count Of(Global.Message_request)] = Array(2, Global.Mafia_team, Hero Icon String(Event Player.Role_icon),
			Custom String("[{0}]님이 [{1}]님을 지목하였습니다", Event Player.Name_plate, Event Player.Target.Name_plate));
		Skip If(Global.Mafia_icon_ID, 1);
		Call Subroutine(Mafia_icon);
		Wait(3, Ignore Condition);
	}
}

rule("마피아 픽 - 클래식 모드")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		(Is Button Held(Event Player, Button(Primary Fire)) || Is Button Held(Event Player, Button(Crouch))) == True;
		Is Crouching(Event Player) == False;
		disabled Global.Game_mode == Custom String("클래식");
		Event Player.Ability == True;
		Event Player.Power_type == 5;
	}

	action
	{
		Skip If(!Is Button Held(Event Player, Button(Primary Fire)), 2);
		Event Player.Hit_scan_player = Ray Cast Hit Player(Eye Position(Event Player), Eye Position(Event Player) + Facing Direction Of(
			Event Player) * 10, Global.Live_players, Event Player, True);
		Abort If(!Event Player.Hit_scan_player);
		Filtered Array(Global.Players, Current Array Element.Power == Event Player.Power).Target = Null;
		Modify Player Variable(Global.Players, Condition, Remove From Array By Value, Event Player.Power);
		If(Is Button Held(Event Player, Button(Primary Fire)));
			Event Player.Target = Event Player.Hit_scan_player;
		Else If(Is Button Held(Event Player, Button(Crouch)));
			Event Player.Target = Event Player;
		End;
		Call Subroutine(Get_ability_target);
		Global.Mafia_team.Sound_effect = 1;
		Abort If(!Event Player.Ability_target);
		Event Player.Ability_target.Condition[Count Of(Event Player.Ability_target.Condition)] = Array(Event Player.Power, Event Player);
		Global.Message_request[Count Of(Global.Message_request)] = Array(2, Global.Mafia_team, Hero Icon String(Event Player.Role_icon),
			Custom String("[{0}]님이 [{1}]님을 지목하였습니다", Event Player.Name_plate, Event Player.Target.Name_plate));
		Skip If(Global.Mafia_icon_ID, 1);
		Call Subroutine(Mafia_icon);
		Wait(3, Ignore Condition);
	}
}

disabled rule("투표 픽")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Jump)) == True;
		Global.Game_mode != Custom String("클래식");
		Event Player.Ability_for_voting == True;
	}

	action
	{
		Event Player.Ability_for_voting -= 1;
		Modify Player Variable(Global.Voter_list[Event Player.Pick_number_for_voting], Votes, Append To Array, Event Player);
		Event Player.Sound_effect = 1;
		Skip If(Event Player.Ability_for_voting, 1);
		Event Player.Done_voting = True;
	}
}

rule("투표 픽 - 클래식 모드")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		(Is Button Held(Event Player, Button(Primary Fire)) || Is Button Held(Event Player, Button(Crouch))) == True;
		Is Crouching(Event Player) == False;
		disabled Global.Game_mode == Custom String("클래식");
		Event Player.Ability_for_voting == True;
	}

	action
	{
		Skip If(!Is Button Held(Event Player, Button(Primary Fire)), 2);
		Event Player.Hit_scan_player = Ray Cast Hit Player(Eye Position(Event Player), Eye Position(Event Player) + Facing Direction Of(
			Event Player) * 10, Global.Live_players, Event Player, True);
		Abort If(!Event Player.Hit_scan_player);
		If(Is Button Held(Event Player, Button(Primary Fire)));
			Event Player.Ability_for_voting -= 1;
			Modify Player Variable(Event Player.Hit_scan_player, Votes, Append To Array, Event Player);
		Else If(Is Button Held(Event Player, Button(Crouch)));
			Event Player.Ability_for_voting -= 1;
			Modify Player Variable(Event Player, Votes, Append To Array, Event Player);
		End;
		Event Player.Sound_effect = 1;
		Skip If(Event Player.Ability_for_voting, 1);
		Event Player.Done_voting = True;
	}
}

rule("승리 조건")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		(Global.Time == 6 || Global.Time == 13) == True;
		Global.Time_muchine != True;
	}

	action
	{
		Call Subroutine(Count_head);
		If(!Filtered Array(Global.Live_players, Current Array Element.Power == Custom String("살해")));
			If(Filtered Array(Global.Live_players, Current Array Element.Role == Custom String("짐승 인간") && Array Contains(Global.Mafia_team,
				Current Array Element)));
				Filtered Array(Global.Live_players, Current Array Element.Role == Custom String("짐승 인간")).Power = Custom String("살해");
				Filtered Array(Global.Live_players, Current Array Element.Role == Custom String("짐승 인간")).Power_able_day = 1;
			Else If(Array Contains(Global.Roles, Custom String("사이비 교주")) && Global.Count_of_TF_team);
				If(Global.Count_of_TF_team >= Global.Count_of_citizen_team);
					Global.Winner_list = Filtered Array(Global.Players, Current Array Element.Team == 6);
					Global.UI = Custom String("교주 팀 승리");
				End;
			Else;
				Global.Winner_list = Filtered Array(Global.Players, Current Array Element.Team == 1);
				Global.UI = Custom String("시민 팀 승리");
			End;
		Else If(Count Of(Global.Live_players) <= 3 && Filtered Array(Global.Live_players, Current Array Element.Role == Custom String(
				"살인마")));
			Global.Winner_list = Filtered Array(Global.Players, Current Array Element.Team == 6);
			Global.UI = Custom String("살인마 승리");
		Else If(Global.Count_of_mafia_team >= Global.Count_of_citizen_team + Global.Count_of_TF_team);
			Global.Winner_list = Filtered Array(Global.Players, Current Array Element.Team == 4);
			Global.UI = Custom String("마피아 팀 승리");
		End;
		If(Global.Winner_list);
			If(Filtered Array(Global.Live_players, Current Array Element.Role == Custom String("스토커") && Array Contains(Global.Winner_list,
				Current Array Element.Value_for_ability)));
				Global.Winner_list = Filtered Array(Global.Players, Current Array Element.Role == Custom String("스토커"));
				Global.UI = Custom String("스토커 승리");
			End;
			Global.Loser_list = Remove From Array(Global.Players, Global.Winner_list);
			Global.Squence = 3;
		End;
	}
}

rule("승패")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Squence == 3;
	}

	action
	{
		If(Array Contains(Global.Loser_list, Event Player));
			Call Subroutine(Create_soul);
			Call Subroutine(Name_plate);
		Else;
			Call Subroutine(Destroy_soul);
			Call Subroutine(Name_plate);
		End;
		If(Event Player.Team_color == 2);
			Create In-World Text(All Players(All Teams), Custom String("{0} [{1}]\r\n\r\n", Hero Icon String(Event Player.Role_icon),
				Event Player.Role), Event Player, 1, Clip Against Surfaces, Visible To Position and String, Color(Red), Default Visibility);
		Else If(Event Player.Team_color == 3);
			Create In-World Text(All Players(All Teams), Custom String("{0} [{1}]\r\n\r\n", Hero Icon String(Event Player.Role_icon),
				Event Player.Role), Event Player, 1, Clip Against Surfaces, Visible To Position and String, Color(Purple), Default Visibility);
		Else If(Event Player.Team_color == 1);
			Create In-World Text(All Players(All Teams), Custom String("{0} [{1}]\r\n\r\n", Hero Icon String(Event Player.Role_icon),
				Event Player.Role), Event Player, 1, Clip Against Surfaces, Visible To Position and String, Color(Blue), Default Visibility);
		Else;
			Create In-World Text(All Players(All Teams), Custom String("{0} [{1}]\r\n\r\n", Hero Icon String(Event Player.Role_icon),
				Event Player.Role), Event Player, 1, Clip Against Surfaces, Visible To Position and String, Color(Orange), Default Visibility);
		End;
		Call Subroutine(Player_position_setting);
		Start Facing(Event Player, Direction Towards(Event Player, Global.Location[6]), 100, To World, Direction and Turn Rate);
		Event Player.Camera_type = 4;
		Wait(3, Ignore Condition);
		If(Array Contains(Global.Winner_list, Event Player));
			Big Message(Event Player, Custom String("승리"));
		Else If(Array Contains(Global.Loser_list, Event Player));
			Big Message(Event Player, Custom String("패배"));
		End;
	}
}

rule("게임 끝")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global.Squence == 3;
	}

	action
	{
		Wait(10, Ignore Condition);
		Global.Squence = 4;
		Declare Player Victory(Random Value In Array(Global.Winner_list));
	}
}

rule("플레이어 참여")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Squence == False;
	}

	action
	{
		Event Player.Joined = True;
	}
}

rule("플레이어 중도 참여")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Global.Squence == True;
		Event Player.Joined == False;
		Has Spawned(Event Player) == True;
	}

	action
	{
		Call Subroutine(Player_setting_for_spectater);
		Kill(Event Player, Null);
	}
}

rule("[서브 루틴] 중도 참여 플레이어 설정")
{
	event
	{
		Subroutine;
		Player_setting_for_spectater;
	}

	action
	{
		Set Invisible(Event Player, All);
		Disable Game Mode HUD(Event Player);
		Disable Hero HUD(Event Player);
		Disable Built-In Game Mode Respawning(Event Player);
		Enable Death Spectate All Players(Event Player);
		Enable Death Spectate Target HUD(Event Player);
	}
}

rule("Squence = 1 6인 이상 참여시 게임 시작")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Is Game In Progress == True;
		Count Of(Filtered Array(All Players(All Teams), Current Array Element.Joined)) >= 6;
	}

	action
	{
		Set Match Time(60);
		Global.Squence = 1;
		Global.Players = Filtered Array(All Players(All Teams), Current Array Element.Joined);
		Global.Count_of_players = Count Of(Global.Players);
		Global.UI_small = Custom String("티켓 확인 하는 중...");
		Wait(2, Ignore Condition);
		Global.UI_small = Custom String("직업을 섞는 중...");
		Call Subroutine(Role_division);
		Global.UI_small = Custom String("노잼 직업 빼는 중...");
		Wait(2, Ignore Condition);
		For Global Variable(For_Division_roles, 0, Count Of(Global.Roles), 1);
			Global.Players[Global.For_Division_roles].Role = Global.Roles[Global.For_Division_roles];
		End;
		Global.UI_small = Custom String("직업 분배 중...");
		Wait(2, Ignore Condition);
		Global.Live_players = Global.Players;
		Global.UI_small = Custom String("게임을 시작하는 중...");
		Wait(2, Ignore Condition);
		Global.Squence = 2;
	}
}

rule("[서브 루틴] 직업 선정")
{
	event
	{
		Subroutine;
		Role_division;
	}

	action
	{
		Global.Roles = Empty Array;
		If(Global.Game_mode == Custom String("클래식"));
			Call Subroutine(Role_division_classic_mode);
		Else If(Global.Game_mode == Custom String("하드"));
			Call Subroutine(Role_division_hard_mode);
		Else;
			Call Subroutine(Role_division_nomal_mode);
		End;
		Global.Roles = Randomized Array(Global.Roles);
	}
}

rule("[서브 루틴] 직업 선정 - 노말 모드")
{
	event
	{
		Subroutine;
		Role_division_nomal_mode;
	}

	action
	{
		Modify Global Variable(Roles, Append To Array, Custom String("마피아"));
		Modify Global Variable(Roles, Append To Array, Custom String("마피아"));
		Modify Global Variable(Roles, Append To Array, Custom String("경찰"));
		Modify Global Variable(Roles, Append To Array, Custom String("의사"));
		Call Subroutine(Citizen_SR_picking);
		If(Global.Count_of_players >= 8);
			Call Subroutine(Mafia_SR_picking);
			Call Subroutine(Citizen_SR_picking);
			If(Global.Count_of_players >= 10);
				Call Subroutine(TF_picking);
				If(Global.Count_of_players >= 11);
					Call Subroutine(Citizen_SR_picking);
					If(Global.Count_of_players >= 12);
						Modify Global Variable(Roles, Append To Array, Custom String("마피아"));
					End;
				End;
			End;
		End;
		While(Count Of(Global.Roles) < Global.Count_of_players);
			Modify Global Variable(Roles, Append To Array, Custom String("시민"));
		End;
	}
}

rule("[서브 루틴] 직업 선정 - 클래식 모드")
{
	event
	{
		Subroutine;
		Role_division_classic_mode;
	}

	action
	{
		Modify Global Variable(Roles, Append To Array, Custom String("마피아"));
		Modify Global Variable(Roles, Append To Array, Custom String("마피아"));
		Modify Global Variable(Roles, Append To Array, Custom String("경찰"));
		Modify Global Variable(Roles, Append To Array, Custom String("의사"));
		If(Global.Count_of_players >= 9);
			Modify Global Variable(Roles, Append To Array, Custom String("스파이"));
			If(Global.Count_of_players >= 11);
				Modify Global Variable(Roles, Append To Array, Custom String("마피아"));
			End;
		End;
		While(Count Of(Global.Roles) < Global.Count_of_players);
			Modify Global Variable(Roles, Append To Array, Custom String("시민"));
		End;
	}
}

rule("[서브 루틴] 직업 선정 - 하드 모드")
{
	event
	{
		Subroutine;
		Role_division_hard_mode;
	}

	action
	{
		Modify Global Variable(Roles, Append To Array, Custom String("마피아"));
		Modify Global Variable(Roles, Append To Array, Custom String("마피아"));
		Modify Global Variable(Roles, Append To Array, Custom String("경찰"));
		Modify Global Variable(Roles, Append To Array, Custom String("의사"));
		Call Subroutine(Citizen_SR_picking);
		Call Subroutine(Citizen_SR_picking);
		If(Global.Count_of_players >= 7);
			Call Subroutine(Citizen_SR_picking);
			If(Global.Count_of_players >= 8);
				Call Subroutine(Mafia_SR_picking);
				If(Global.Count_of_players >= 9);
					Call Subroutine(Citizen_SR_picking);
					If(Global.Count_of_players >= 10);
						Call Subroutine(TF_picking);
						If(Global.Count_of_players >= 11);
							Modify Global Variable(Roles, Append To Array, Custom String("마피아"));
							If(Global.Count_of_players >= 12);
								Call Subroutine(Citizen_SR_picking);
							End;
						End;
					End;
				End;
			End;
		End;
	}
}

rule("[서브 루틴] 시민 특직 선정")
{
	event
	{
		Subroutine;
		Citizen_SR_picking;
	}

	action
	{
		Wait(0.100, Ignore Condition);
		Global.Pick_role = Null;
		Global.Random_value = Random Real(0, 100);
		If(Global.Random_value <= 11.111);
			Global.Pick_role = Custom String("탐정");
		Else If(Global.Random_value <= 22.222);
			Global.Pick_role = Custom String("영매");
		Else If(Global.Random_value <= 33.333);
			Global.Pick_role = Custom String("건달");
		Else If(Global.Random_value <= 40);
			Global.Pick_role = Custom String("도굴꾼");
		Else If(Global.Random_value <= 48.889);
			Global.Pick_role = Custom String("기자");
		Else If(Global.Random_value <= 60);
			Global.Pick_role = Custom String("정치인");
		Else If(Global.Random_value <= 68.889);
			Global.Pick_role = Custom String("성직자");
		Else If(Global.Random_value <= 77.778);
			Global.Pick_role = Custom String("군인");
		Else If(Global.Random_value <= 86.667);
			Global.Pick_role = Custom String("테러리스트");
		Else If(Global.Random_value <= 93.333);
			Global.Pick_role = Custom String("흑기사");
		Else If(Global.Random_value <= 100);
			Global.Pick_role = Custom String("관찰자");
		End;
		If(!Array Contains(Global.Citizen_SR_setting, Global.Pick_role) || Array Contains(Global.Roles, Global.Pick_role));
			Loop;
		Else;
			Modify Global Variable(Roles, Append To Array, Global.Pick_role);
		End;
	}
}

