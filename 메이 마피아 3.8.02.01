			Event Player.P_Message_request[Count Of(Event Player.P_Message_request)] = Array(3, Event Player, Hero Icon String(Hero(위도우메이커)),
				Random Value In Array(Array(Custom String("마담: "))));
		Else;
			Event Player.P_Message_request[Count Of(Event Player.P_Message_request)] = Array(1, All Players(All Teams), Hero Icon String(Hero(
				자리야)), Random Value In Array(Array(Custom String("[군인]이 [{0}]의 공격을 받았습니다", Mapped Array(Filtered Array(Event Player.Condition,
				Array Contains(Global.Power_array[0], Current Array Element)), Last Of(Current Array Element)).Role))));
			Event Player.Power_able_left -= 1;
		End;
	}
}

