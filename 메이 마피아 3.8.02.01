		Event Player.Tips_and_jokes = Array(Custom String("Tip: 타임머신의 전설을 아시나요?"), Custom String("Tip: 첫 밤에 누군가 죽기를 간절히 빌어보세요"));
		Event Player.Tip_or_joke = Random Value In Array(Event Player.Tips_and_jokes);
