			Global.Able_role_setting[1] = Custom String("{0}{1}", Global.Able_role_setting[1] ? Global.Able_role_setting[1] : Custom String(
				""), Custom String("{0}　", Global.Mafia_SR_setting[Global.For_Able_role_setting]));
			If(!((Global.For_Able_role_setting + 1) % 5) && Global.Mafia_SR_setting[Global.For_Able_role_setting] != Last Of(
				Global.Mafia_SR_setting));
				Global.Able_role_setting[1] = Custom String("{0}{1}", Global.Able_role_setting[1] ? Global.Able_role_setting[1] : Custom String(
					""), Custom String("\r\n"));
			End;
		End;
	}
}

